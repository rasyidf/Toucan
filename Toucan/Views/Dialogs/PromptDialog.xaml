<ui:FluentWindow
    x:Class="Toucan.PromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="480"
    Height="240"
    MinWidth="380"
    MinHeight="220"
    MaxWidth="600"
    MaxHeight="280"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="titleBarPrompt" Title="New Translation Key"
                     ShowMaximize="False" ShowMinimize="False"/>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,8,24,12" VerticalAlignment="Center">
            <TextBlock x:Name="messageLabel" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,12"
                       d:Text="Enter the key for the new translation."/>

            <ui:TextBox x:Name="ResponseTextBox"
                        PlaceholderText="e.g., common.buttons.save"
                        Icon="Key20"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,8" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelDialog"/>
                <ui:Button Content="Add" Width="90" Appearance="Primary" Click="OKButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
