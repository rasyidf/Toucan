<ui:FluentWindow
    x:Class="Toucan.Views.Dialogs.ProjectDefaultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Title="Manage Project Defaults"
    Width="720" Height="620"
    MinWidth="600" MinHeight="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Manage Project Defaults" Grid.Row="0" ShowHelp="False" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}" Padding="0,4,4,8">
                <ListBox x:Name="NavList" SelectedIndex="0" SelectionChanged="NavList_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SettingsNavListViewItemStyle}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Edit24" Margin="0,0,10,0"/>
                            <TextBlock Text="Editor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Translate24" Margin="0,0,10,0"/>
                            <TextBlock Text="Translation" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,10,0"/>
                            <TextBlock Text="Validation" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24" Margin="0,0,10,0"/>
                            <TextBlock Text="Source Code" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ToggleRight24" Margin="0,0,10,0"/>
                            <TextBlock Text="Features" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,12">
                <Grid>
                    <!-- Editor Page -->
                    <StackPanel x:Name="PageEditor" Visibility="Visible">
                        <TextBlock Text="Editor Defaults" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="These values are used for new projects and as fallback when a project doesn't override them." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="LocalLanguage24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Default language" FontWeight="SemiBold"/>
                                        <TextBlock Text="Primary language for new projects" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="140" SelectedValue="{Binding DefaultLanguage, Mode=TwoWay}" SelectedValuePath="Content" IsEditable="True" Text="{Binding DefaultLanguage, Mode=TwoWay}">
                                <ComboBoxItem>en-US</ComboBoxItem>
                                <ComboBoxItem>en</ComboBoxItem>
                                <ComboBoxItem>fr-FR</ComboBoxItem>
                                <ComboBoxItem>es-ES</ComboBoxItem>
                                <ComboBoxItem>de-DE</ComboBoxItem>
                                <ComboBoxItem>id-ID</ComboBoxItem>
                                <ComboBoxItem>zh-CN</ComboBoxItem>
                                <ComboBoxItem>ja-JP</ComboBoxItem>
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Save24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Save empty translations" FontWeight="SemiBold"/>
                                        <TextBlock Text="Write keys with empty values to output files" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <CheckBox IsChecked="{Binding SaveEmptyTranslations, Mode=TwoWay}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSort24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Translation order" FontWeight="SemiBold"/>
                                        <TextBlock Text="Key sort order when saving" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" SelectedValue="{Binding TranslationOrder, Mode=TwoWay}" SelectedValuePath="Content">
                                <ComboBoxItem>Alphabetically sorted</ComboBoxItem>
                                <ComboBoxItem>Primary language</ComboBoxItem>
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Comment24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Comments enabled" FontWeight="SemiBold"/>
                                        <TextBlock Text="Enable translation comments and notes" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <CheckBox IsChecked="{Binding CommentsEnabled, Mode=TwoWay}"/>
                        </ui:CardControl>

                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Copy Templates</TextBlock>
                        <TextBlock Text="Use %1 as placeholder for the key namespace. Min 1, max 5." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding CopyTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:CardControl Margin="0,0,0,4">
                                        <ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Copy16" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            MinWidth="260" PlaceholderText="%1"/>
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:Button Padding="4,2" Appearance="Transparent"
                                                   Command="{Binding DataContext.RemoveCopyTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="12"/>
                                        </ui:Button>
                                    </ui:CardControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Content="Add Template" Margin="0,4,0,0" Appearance="Transparent" Padding="8,4"
                                   Command="{Binding AddCopyTemplateCommand}" IsEnabled="{Binding CanAddCopyTemplate}">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Add16"/></ui:Button.Icon>
                        </ui:Button>

                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Default Languages</TextBlock>
                        <TextBlock Text="Languages to include when creating new projects (comma-separated)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding DefaultProjectLanguages, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Translation Page -->
                    <StackPanel x:Name="PageTranslation" Visibility="Collapsed">
                        <TextBlock Text="Translation Defaults" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CloudSync24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Default provider" FontWeight="SemiBold"/>
                                        <TextBlock Text="Translation service for new projects" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="140" SelectedValue="{Binding DefaultProvider, Mode=TwoWay}" SelectedValuePath="Content" IsEditable="True" Text="{Binding DefaultProvider, Mode=TwoWay}">
                                <ComboBoxItem>Google</ComboBoxItem>
                                <ComboBoxItem>DeepL</ComboBoxItem>
                                <ComboBoxItem>Microsoft</ComboBoxItem>
                                <ComboBoxItem>OpenAI</ComboBoxItem>
                                <ComboBoxItem>Custom</ComboBoxItem>
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="TextGrammarWand24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Formality" FontWeight="SemiBold"/>
                                        <TextBlock Text="Default tone for machine translations" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="140" SelectedValue="{Binding Formality, Mode=TwoWay}" SelectedValuePath="Content">
                                <ComboBoxItem>Default</ComboBoxItem>
                                <ComboBoxItem>Formal</ComboBoxItem>
                                <ComboBoxItem>Informal</ComboBoxItem>
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Shield24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Preserve placeholders" FontWeight="SemiBold"/>
                                        <TextBlock Text="Protect placeholder tokens during translation" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <CheckBox IsChecked="{Binding PreservePlaceholders, Mode=TwoWay}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Eye24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Preview before applying" FontWeight="SemiBold"/>
                                        <TextBlock Text="Show preview before committing translations" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <CheckBox IsChecked="{Binding PreviewBeforeApply, Mode=TwoWay}"/>
                        </ui:CardControl>

                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Context</TextBlock>
                        <TextBlock Text="Default context to improve translation quality" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Context, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Validation Page -->
                    <StackPanel x:Name="PageValidation" Visibility="Collapsed">
                        <TextBlock Text="Validation Defaults" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Validate on save" FontWeight="SemiBold"/>
                                        <TextBlock Text="Run validation when saving projects" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ValidateOnSave, Mode=TwoWay}"/>
                        </ui:CardControl>

                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8">Rules</TextBlock>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Missing translations" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding RuleMissingTranslationEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <ComboBox Width="120" SelectedValue="{Binding RuleMissingTranslationSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                                    <ComboBoxItem>Error</ComboBoxItem>
                                    <ComboBoxItem>Warning</ComboBoxItem>
                                    <ComboBoxItem>Info</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ErrorCircle24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Placeholder mismatch" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding RulePlaceholderMismatchEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <ComboBox Width="120" SelectedValue="{Binding RulePlaceholderMismatchSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                                    <ComboBoxItem>Error</ComboBoxItem>
                                    <ComboBoxItem>Warning</ComboBoxItem>
                                    <ComboBoxItem>Info</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ErrorCircle24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Duplicate keys" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding RuleDuplicateKeyEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <ComboBox Width="120" SelectedValue="{Binding RuleDuplicateKeySeverity, Mode=TwoWay}" SelectedValuePath="Content">
                                    <ComboBoxItem>Error</ComboBoxItem>
                                    <ComboBoxItem>Warning</ComboBoxItem>
                                    <ComboBoxItem>Info</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Untranslated copy" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding RuleUntranslatedCopyEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <ComboBox Width="120" SelectedValue="{Binding RuleUntranslatedCopySeverity, Mode=TwoWay}" SelectedValuePath="Content">
                                    <ComboBoxItem>Error</ComboBoxItem>
                                    <ComboBoxItem>Warning</ComboBoxItem>
                                    <ComboBoxItem>Info</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Empty values" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding RuleEmptyValueEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <ComboBox Width="120" SelectedValue="{Binding RuleEmptyValueSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                                    <ComboBoxItem>Error</ComboBoxItem>
                                    <ComboBoxItem>Warning</ComboBoxItem>
                                    <ComboBoxItem>Info</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Whitespace mismatch" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:ToggleSwitch IsChecked="{Binding RuleWhitespaceMismatchEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                                <ComboBox Width="120" SelectedValue="{Binding RuleWhitespaceMismatchSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                                    <ComboBoxItem>Error</ComboBoxItem>
                                    <ComboBoxItem>Warning</ComboBoxItem>
                                    <ComboBoxItem>Info</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>

                    <!-- Source Code Page -->
                    <StackPanel x:Name="PageSourceCode" Visibility="Collapsed">
                        <TextBlock Text="Source Code Defaults" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Auto-scan on open" FontWeight="SemiBold"/>
                                        <TextBlock Text="Scan source code when project opens" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding AutoScanOnOpen, Mode=TwoWay}"/>
                        </ui:CardControl>

                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8">File Extensions</TextBlock>
                        <TextBox Text="{Binding ScanExtensions, Mode=TwoWay}" TextWrapping="Wrap" MinHeight="50"/>

                        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8">Excluded Directories</TextBlock>
                        <TextBox Text="{Binding ExcludedDirectories, Mode=TwoWay}" TextWrapping="Wrap" MinHeight="50"/>

                        <ui:CardControl Margin="0,12,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="External editor" FontWeight="SemiBold"/>
                                        <TextBlock Text="Command to open files (use {file} and {line})" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox Width="240" Text="{Binding ExternalEditor, Mode=TwoWay}" PlaceholderText="code --goto {file}:{line}"/>
                        </ui:CardControl>
                    </StackPanel>

                    <!-- Features Page -->
                    <StackPanel x:Name="PageFeatures" Visibility="Collapsed">
                        <TextBlock Text="Feature Defaults" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Save24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Auto-save" FontWeight="SemiBold"/>
                                        <TextBlock Text="Automatically save at regular intervals" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <CheckBox IsChecked="{Binding AutoSaveEnabled, Mode=TwoWay}"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,4">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Timer24" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Auto-save interval" FontWeight="SemiBold"/>
                                        <TextBlock Text="Seconds between saves (10–600)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <TextBox Width="80" Text="{Binding AutoSaveIntervalText, Mode=TwoWay}"/>
                        </ui:CardControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <ui:Button Content="Reset to Factory" HorizontalAlignment="Left" Appearance="Secondary" Command="{Binding ResetToFactoryDefaultsCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Width="90" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
                    <ui:Button Content="Save" Width="90" Appearance="Primary" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
