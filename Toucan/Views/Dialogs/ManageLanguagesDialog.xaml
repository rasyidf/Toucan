<ui:FluentWindow
    x:Class="Toucan.Views.Dialogs.ManageLanguagesDialog"
    x:Name="LanguageManagerRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Toucan.ViewModels"
    xmlns:components="clr-namespace:Toucan.Views.Components"
    Title="Manage Languages"
    Width="540"
    Height="500"
    MinWidth="440"
    MinHeight="380"
    WindowStartupLocation="CenterOwner"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    d:DataContext="{d:DesignInstance Type=vm:LanguageManagerViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Manage Languages" ShowMaximize="False" ShowMinimize="False"/>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8,16,0">
            <components:LanguageListEditor
                x:Name="LanguageEditor"
                Items="{Binding Languages}"
                Description="Search language to add (e.g., fr, French, de-DE)"
                AllowSetPrimary="True"
                LanguageAdded="LanguageEditor_LanguageAdded"
                LanguageRemoved="LanguageEditor_LanguageRemoved"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Right-click a language for more options. The primary language cannot be removed."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" Width="90" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <ui:Button Content="Save" Width="90" Appearance="Primary" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
