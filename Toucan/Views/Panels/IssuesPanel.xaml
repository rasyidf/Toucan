<UserControl x:Class="Toucan.Views.Panels.IssuesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Toucan.Converters"
    xmlns:vm="clr-namespace:Toucan.ViewModels">
    <UserControl.Resources>
        <c:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <CollectionViewSource x:Key="GroupedIssues" Source="{Binding ValidationIssues}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="RuleId"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <!-- Issues list grouped by rule type -->
        <ListView ItemsSource="{Binding Source={StaticResource GroupedIssues}}"
                  BorderThickness="0" Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="IssuesList_SelectionChanged"
                  x:Name="IssuesList">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Dismiss" Command="{Binding DismissIssueCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Dismiss all of this type"
                              Command="{Binding DismissIssuesByRuleCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem.RuleId, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Dismiss all" Command="{Binding DismissAllIssuesCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Padding="8,6,8,4" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                    Margin="0,2,0,0" CornerRadius="4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}"
                                               FontSize="10" Opacity="0.6" VerticalAlignment="Center"
                                               Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ValidationIssueItem}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Severity icon -->
                        <ui:SymbolIcon Grid.RowSpan="2" Symbol="Warning16" FontSize="12" Margin="0,2,8,0"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        <!-- Key namespace -->
                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="12" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- Detail -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Message}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="32" Opacity="0.3" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="No issues" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Run validation to check for problems" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
