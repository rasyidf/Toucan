<UserControl x:Class="Toucan.Views.Panels.SearchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Toucan.Converters"
    xmlns:models="clr-namespace:Toucan.Core.Models;assembly=Toucan.Core">
    <UserControl.Resources>
        <c:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <c:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <c:SearchScopeToIndexConverter x:Key="ScopeToIndex"/>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search box with regex toggle and replace chevron -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search translations..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                <!-- Regex toggle -->
                <ui:Button Content=".*"
                           ToolTip="Toggle regex mode"
                           Padding="6,4" FontSize="11" FontFamily="Consolas"
                           Command="{Binding ToggleRegexCommand}"
                           Margin="0,0,2,0">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseRegex}" Value="True">
                                    <Setter Property="Appearance" Value="Secondary"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <!-- Replace panel toggle (chevron) -->
                <ui:Button Appearance="Transparent"
                           ToolTip="Toggle Replace panel"
                           Padding="6,4"
                           Command="{Binding ToggleReplacePanelCommand}">
                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12"/>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Replace box (collapsible) -->
        <Grid Grid.Row="1" Margin="0,0,0,6"
              Visibility="{Binding ShowReplacePanel, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Replace with..."
                        Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                <ui:Button Appearance="Transparent" Content="Preview"
                           ToolTip="Preview replacements"
                           Padding="6,4" FontSize="11"
                           Command="{Binding PreviewReplaceCommand}"
                           Margin="0,0,2,0"/>
                <ui:Button Appearance="Primary" Content="Replace All"
                           ToolTip="Apply replacements"
                           Padding="6,4" FontSize="11"
                           Command="{Binding ExecuteReplaceCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Scope dropdown + Search button -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" FontSize="11"
                      SelectedIndex="{Binding SearchScope, Converter={StaticResource ScopeToIndex}}">
                <ComboBoxItem Content="All Languages"/>
                <ComboBoxItem Content="Current Language"/>
                <ComboBoxItem Content="Current Namespace"/>
            </ComboBox>

            <ui:Button Grid.Column="1" Appearance="Primary"
                       Content="Search" Padding="8,4" FontSize="11"
                       Margin="4,0,0,0"
                       Command="{Binding ExecuteSearchCommand}"/>
        </Grid>

        <!-- Filter buttons -->
        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <ui:Button Appearance="Transparent" Content="All" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                       Command="{Binding ClearFilterCommand}"/>
            <ui:Button Appearance="Transparent" Content="Untranslated" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                       Command="{Binding ShowUntranslatedCommand}"/>
            <ui:Button Appearance="Transparent" Content="Translated" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                       Command="{Binding ShowTranslatedCommand}"/>
            <ui:Button Appearance="Transparent" Content="Approved" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                       Command="{Binding ShowApprovedCommand}"/>
            <ui:Button Appearance="Transparent" Content="Used" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                       Command="{Binding FilterUsedKeysCommand}"/>
            <ui:Button Appearance="Transparent" Content="Unused" Padding="6,3" FontSize="11"
                       Command="{Binding FilterUnusedKeysCommand}"/>
        </WrapPanel>

        <!-- Status / results count -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   FontSize="11"
                   Opacity="0.6"
                   Margin="0,0,0,4"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Results list -->
        <ListBox Grid.Row="5"
                 ItemsSource="{Binding SearchResults}"
                 SelectedItem="{Binding SelectedSearchResult}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SearchResultItem}">
                    <StackPanel Margin="2,4">
                        <!-- Key + Language badge -->
                        <DockPanel>
                            <TextBlock Text="{Binding Language}" DockPanel.Dock="Right"
                                       FontSize="10" Opacity="0.5" Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <!-- Value -->
                        <TextBlock FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Value}" Margin="0,2,0,0"/>
                        <!-- Replacement preview -->
                        <TextBlock FontSize="10" Foreground="Green" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"
                                   Visibility="{Binding ReplacedValue, Converter={StaticResource NullToCollapsed}}">
                            <Run Text="&#x2192; "/><Run Text="{Binding ReplacedValue, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Placeholder when idle -->
        <TextBlock Grid.Row="5"
                   Text="Type to search across all keys and values"
                   FontSize="11"
                   Opacity="0.35"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchText}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
