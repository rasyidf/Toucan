<UserControl
    x:Class="Toucan.Views.Settings.LanguagesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:components="clr-namespace:Toucan.Views.Components">
    <StackPanel>
        <TextBlock Text="Languages" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Suggested Languages</TextBlock>
        <TextBlock Text="These languages appear when clicking 'Add suggested' in the New Project dialog." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

        <components:LanguageListEditor
            x:Name="SuggestedLangEditor"
            Items="{Binding SuggestedLanguageEntries}"
            Description="Type a language code and press Add"
            AllowSetPrimary="False"/>
    </StackPanel>
</UserControl>
