<UserControl
    x:Class="Toucan.Views.Settings.DataPrivacySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Text="Data &amp; Privacy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Clear Data</TextBlock>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="History24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Filter history" FontWeight="SemiBold"/>
                        <TextBlock Text="Clear saved search/filter history" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Clear" Command="{Binding ClearFilterHistoryCommand}"/>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Recent projects" FontWeight="SemiBold"/>
                        <TextBlock Text="Clear the list of recently opened projects" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Clear" Command="{Binding ClearRecentProjectsCommand}"/>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Database24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Translation memory" FontWeight="SemiBold"/>
                        <TextBlock Text="Clear all stored translation memory entries" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Clear TM" Appearance="Caution" Command="{Binding ClearTranslationMemoryCommand}"/>
        </ui:CardControl>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Backup &amp; Restore</TextBlock>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowUpload24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Export settings" FontWeight="SemiBold"/>
                        <TextBlock Text="Export all app settings and project defaults to a JSON file" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Export..." Command="{Binding ExportSettingsCommand}"/>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Import settings" FontWeight="SemiBold"/>
                        <TextBlock Text="Restore settings from a previously exported file" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Import..." Command="{Binding ImportSettingsCommand}"/>
        </ui:CardControl>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Reset</TextBlock>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowReset24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Reset all settings" FontWeight="SemiBold"/>
                        <TextBlock Text="Restore all app and project default settings to factory values" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Reset..." Appearance="Caution" Command="{Binding ResetAllSettingsCommand}"/>
        </ui:CardControl>
    </StackPanel>
</UserControl>
