<UserControl
    x:Class="Toucan.Views.Settings.ValidationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Text="Validation" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Behavior</TextBlock>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Validate on save" FontWeight="SemiBold"/>
                        <TextBlock Text="Run validation pipeline automatically when saving" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ValidateOnSave, Mode=TwoWay}"/>
        </ui:CardControl>

        <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8">Rules</TextBlock>
        <TextBlock Text="Enable or disable individual validation rules and set their severity" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

        <!-- Missing Translations -->
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Missing translations" FontWeight="SemiBold"/>
                        <TextBlock Text="Keys in primary language without target translation" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding RuleMissingTranslationEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ComboBox Width="120" SelectedValue="{Binding RuleMissingTranslationSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                    <ComboBoxItem>Error</ComboBoxItem>
                    <ComboBoxItem>Warning</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ui:CardControl>

        <!-- Placeholder Mismatch -->
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Placeholder mismatch" FontWeight="SemiBold"/>
                        <TextBlock Text="Different placeholder count between source and target" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding RulePlaceholderMismatchEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ComboBox Width="120" SelectedValue="{Binding RulePlaceholderMismatchSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                    <ComboBoxItem>Error</ComboBoxItem>
                    <ComboBoxItem>Warning</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ui:CardControl>

        <!-- Duplicate Keys -->
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Duplicate keys" FontWeight="SemiBold"/>
                        <TextBlock Text="Same key appears multiple times for a language" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding RuleDuplicateKeyEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ComboBox Width="120" SelectedValue="{Binding RuleDuplicateKeySeverity, Mode=TwoWay}" SelectedValuePath="Content">
                    <ComboBoxItem>Error</ComboBoxItem>
                    <ComboBoxItem>Warning</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ui:CardControl>

        <!-- Untranslated Copy -->
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Untranslated (same as source)" FontWeight="SemiBold"/>
                        <TextBlock Text="Translation value identical to source text" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding RuleUntranslatedCopyEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ComboBox Width="120" SelectedValue="{Binding RuleUntranslatedCopySeverity, Mode=TwoWay}" SelectedValuePath="Content">
                    <ComboBoxItem>Error</ComboBoxItem>
                    <ComboBoxItem>Warning</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ui:CardControl>

        <!-- Empty Values -->
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Empty values" FontWeight="SemiBold"/>
                        <TextBlock Text="Keys with empty or whitespace-only values" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding RuleEmptyValueEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ComboBox Width="120" SelectedValue="{Binding RuleEmptyValueSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                    <ComboBoxItem>Error</ComboBoxItem>
                    <ComboBoxItem>Warning</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ui:CardControl>

        <!-- Whitespace Mismatch -->
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Whitespace mismatch" FontWeight="SemiBold"/>
                        <TextBlock Text="Leading/trailing whitespace differs from source" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch IsChecked="{Binding RuleWhitespaceMismatchEnabled, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ComboBox Width="120" SelectedValue="{Binding RuleWhitespaceMismatchSeverity, Mode=TwoWay}" SelectedValuePath="Content">
                    <ComboBoxItem>Error</ComboBoxItem>
                    <ComboBoxItem>Warning</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</UserControl>
