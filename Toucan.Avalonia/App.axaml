<Application x:Class="Toucan.Avalonia.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:conv="using:Toucan.Avalonia.Converters"
             Name="Toucan"
             RequestedThemeVariant="Default">

  <!-- macOS application menu (the "Toucan" menu). Other platforms use the in-window menu. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{loc:Loc 'About Toucan'}" Click="OnAboutClick"/>
      <NativeMenuItemSeparator/>
      <NativeMenuItem Header="{loc:Loc 'Settings…'}" Gesture="Cmd+OemComma" Click="OnPreferencesClick"/>
    </NativeMenu>
  </NativeMenu.Menu>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Toucan/Styles/Resources/Tokens.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:LanguageNameConverter x:Key="LanguageName"/>
      <conv:SymbolConverter x:Key="Symbol"/>
      <conv:EqualsConverter x:Key="Equals"/>
      <conv:SeverityBrushConverter x:Key="SeverityBrush"/>
      <conv:PercentToHealthBrushConverter x:Key="HealthBrush"/>
      <conv:StatusBrushConverter x:Key="StatusBrush"/>

      <!-- Keep variant dictionaries here: ColorSchemeService writes user overrides into them. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Toucan/Styles/Resources/Light.axaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Toucan/Styles/Resources/Dark.axaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Linux follows Avalonia's platform theme through ThemeService instead of
         FluentAvalonia's optional gsettings command-line helper. -->
    <sty:FluentAvaloniaTheme PreferSystemTheme="{OnPlatform Default=True, Linux=False}" PreferUserAccentColor="False" CustomAccentColor="#0097A7"/>
    <StyleInclude Source="avares://Toucan/Styles/AppStyles.axaml"/>
  </Application.Styles>
</Application>
