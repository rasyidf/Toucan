<UserControl x:Class="Toucan.Avalonia.Views.Panels.ExplorerPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:conv="using:Toucan.Avalonia.Converters">

  <DockPanel>
    <!-- Hidden namespaces: collapsible footer -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
            IsVisible="{Binding HiddenNamespaces.Count}">
      <StackPanel>
        <ToggleButton x:Name="HiddenToggle" Classes="row" IsChecked="False" Padding="12,8" CornerRadius="0"
                      HorizontalContentAlignment="Stretch">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <ui:FASymbolIcon Symbol="View" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{loc:Loc 'Hidden namespaces'}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="2" Classes="badge" Margin="8,0">
              <TextBlock Text="{Binding HiddenNamespaces.Count}"/>
            </Border>
            <ui:FASymbolIcon Grid.Column="3" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                             Symbol="{Binding #HiddenToggle.IsChecked, Converter={x:Static conv:ExpanderChevronConverter.Instance}}"/>
          </Grid>
        </ToggleButton>
        <ItemsControl ItemsSource="{Binding HiddenNamespaces}" IsVisible="{Binding #HiddenToggle.IsChecked}" Margin="12,0,12,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" MinHeight="28">
                <TextBlock Text="{Binding}" Classes="mono caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Classes="link" Content="{loc:Loc 'Show'}" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].DataContext.UnhideNamespaceCommand}" CommandParameter="{Binding}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Panel>
      <TreeView x:Name="Tree" ItemsSource="{Binding CurrentTreeItems}" SelectedItem="{Binding SelectedNode}"
                IsVisible="{Binding IsTreeView}" Padding="4">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="MinHeight" Value="26"/>
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Items}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Panel Width="14">
                <ui:FASymbolIcon Symbol="Folder" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" IsVisible="{Binding HasItems}"/>
                <ui:FASymbolIcon Symbol="Tag" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" IsVisible="{Binding !HasItems}"/>
              </Panel>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <ListBox x:Name="FlatList" Classes="plain" ItemsSource="{Binding CurrentFlatItems}" IsVisible="{Binding !IsTreeView}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayKey}" Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullKey}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding !CurrentTreeItems.Count}" Margin="16,24" Spacing="8">
        <TextBlock Text="{loc:Loc 'This project has no keys yet.'}" Classes="caption" TextWrapping="Wrap"/>
        <Button Content="{loc:Loc 'Add translation key…'}" Command="{Binding NewItemCommand}"/>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
