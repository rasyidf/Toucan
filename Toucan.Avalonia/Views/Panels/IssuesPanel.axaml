<UserControl x:Class="Toucan.Avalonia.Views.Panels.IssuesPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="12,8" Spacing="8">
      <TextBlock Text="{Binding ValidationSummary}" Classes="caption" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="{loc:Loc 'Run validation'}" Classes="accent" Command="{Binding RunValidationCommand}"/>
        <Button Content="{loc:Loc 'Analyze with AI…'}" Command="{Binding AnalyzeTranslationsCommand}"/>
      </StackPanel>
    </StackPanel>
    <ListBox Classes="plain" ItemsSource="{Binding ValidationIssues}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Width="8" Height="8" Margin="0,5,8,0" VerticalAlignment="Top"
                     Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
            <Button Grid.Column="1" Classes="row" Padding="0" Command="{Binding $parent[UserControl].DataContext.RevealIssueCommand}" CommandParameter="{Binding}">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Key}" Classes="mono caption" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/>
                <TextBlock Text="{Binding SuggestedFix, StringFormat='Fix: {0}'}" Classes="hint" IsVisible="{Binding HasFix}"/>
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Classes="icon small" ToolTip.Tip="{loc:Loc 'Apply suggested fix'}" IsVisible="{Binding HasFix}"
                      Command="{Binding $parent[UserControl].DataContext.ApplyFixCommand}" CommandParameter="{Binding}">
                <ui:FASymbolIcon Symbol="Repair"/>
              </Button>
              <Button Classes="icon small" ToolTip.Tip="{loc:Loc 'Dismiss'}"
                      Command="{Binding $parent[UserControl].DataContext.DismissIssueCommand}" CommandParameter="{Binding}">
                <ui:FASymbolIcon Symbol="Dismiss"/>
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
