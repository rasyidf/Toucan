<UserControl x:Class="Toucan.Avalonia.Views.Panels.TranslationMemoryPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls">
  <ScrollViewer>
    <StackPanel Margin="12,8" Spacing="6">
      <TextBlock TextWrapping="Wrap" Classes="caption"
                 Text="Translation memory remembers source → target pairs from projects you save, and suggests them for similar text."/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding TmEntryCount}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="entries" Classes="caption" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
      </StackPanel>
      <WrapPanel>
        <Button Content="Learn from project" Command="{Binding LearnProjectIntoMemoryCommand}" Margin="0,0,6,6"/>
        <Button Content="Import TMX…" Command="{Binding ImportTmxCommand}" Margin="0,0,6,6"/>
        <Button Content="Export TMX…" Command="{Binding ExportTmxCommand}" Margin="0,0,6,6"/>
      </WrapPanel>

      <TextBlock Text="MATCHES FOR SELECTED KEY" Classes="section"/>
      <TextBlock Text="Select a key with a source value to see matches." Classes="caption" TextWrapping="Wrap"
                 IsVisible="{Binding !HasMemoryMatches}"/>
      <ItemsControl ItemsSource="{Binding MemoryMatches}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="row" Padding="6,4" ToolTip.Tip="Insert into the focused field"
                    Command="{Binding $parent[UserControl].DataContext.InsertSuggestionCommand}" CommandParameter="{Binding Text}">
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Left" Classes="badge" Margin="0,0,6,0"><TextBlock Text="{Binding Label}"/></Border>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                </DockPanel>
                <TextBlock Text="{Binding Detail}" Classes="hint" MaxLines="2" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="SUGGESTION FOR FOCUSED FIELD" Classes="section" IsVisible="{Binding GhostSuggestion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <Button Classes="row" Padding="6,4" IsVisible="{Binding GhostSuggestion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Command="{Binding InsertSuggestionCommand}" CommandParameter="{Binding GhostSuggestion}">
        <TextBlock Text="{Binding GhostSuggestion}" TextWrapping="Wrap" FontSize="12"/>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
