<UserControl x:Class="Toucan.Avalonia.Views.Panels.InspectorPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls">
  <Panel>
    <StackPanel IsVisible="{Binding !HasSelectedKeyDetails}" Margin="16,24" Spacing="6">
      <ui:FASymbolIcon Symbol="Tag" FontSize="28" Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Left"/>
      <TextBlock Text="{loc:Loc 'Select a key to see its details, suggestions, and where it\'s used.'}" Classes="caption" TextWrapping="Wrap"/>
    </StackPanel>

    <ScrollViewer IsVisible="{Binding HasSelectedKeyDetails}">
      <StackPanel Margin="12,4,12,12">
        <TextBlock Text="{loc:Loc 'KEY'}" Classes="section"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="{loc:Loc 'Copy key'}"
                  Command="{Binding CopyKeyCommand}" CommandParameter="{Binding SelectedKeyNamespace}">
            <ui:FASymbolIcon Symbol="Copy"/>
          </Button>
          <SelectableTextBlock Text="{Binding SelectedKeyNamespace}" Classes="mono" FontSize="12" TextWrapping="Wrap"/>
        </DockPanel>
        <WrapPanel Margin="0,6,0,0">
          <Button Classes="link" Content="{loc:Loc 'Translate empty'}" Command="{Binding TranslateSelectedKeyCommand}"/>
          <Button Classes="link" Content="{loc:Loc 'Plural forms'}" Command="{Binding GeneratePluralFormsCommand}"/>
          <Button Classes="link" Content="{loc:Loc 'Gender forms'}" Command="{Binding GenerateGenderFormsCommand}"/>
        </WrapPanel>

        <TextBlock Text="{loc:Loc 'LANGUAGES'}" Classes="section"/>
        <ItemsControl ItemsSource="{Binding SelectedKeyLanguages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="56,*,Auto" Margin="0,2">
                <TextBlock Text="{Binding Language}" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" Classes="caption" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding SelectedKeyComment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{loc:Loc 'COMMENT'}" Classes="section"/>
          <TextBlock Text="{Binding SelectedKeyComment}" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasMemoryMatches}">
          <TextBlock Text="{loc:Loc 'TRANSLATION MEMORY'}" Classes="section"/>
          <ItemsControl ItemsSource="{Binding MemoryMatches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row" Padding="6,4" ToolTip.Tip="{loc:Loc 'Insert into the focused field'}"
                        Command="{Binding $parent[UserControl].DataContext.InsertSuggestionCommand}" CommandParameter="{Binding Text}">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Classes="badge" Margin="0,0,6,0"><TextBlock Text="{Binding Label}"/></Border>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Classes="hint" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasSuggestions}">
          <TextBlock Text="{loc:Loc 'SIMILAR KEYS'}" Classes="section"/>
          <ItemsControl ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row" Padding="6,4" ToolTip.Tip="{loc:Loc 'Go to key'}"
                        Command="{Binding $parent[UserControl].DataContext.RevealKeyCommand}" CommandParameter="{Binding Label}">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" Classes="mono caption" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" MaxLines="2"/>
                    <TextBlock Text="{Binding Detail}" Classes="hint"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasSelectedKeyUsages}">
          <TextBlock Text="{loc:Loc 'USED IN SOURCE'}" Classes="section"/>
          <ItemsControl ItemsSource="{Binding SelectedKeyUsages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row" Padding="6,4" ToolTip.Tip="{Binding LineContent}"
                        Command="{Binding $parent[UserControl].DataContext.OpenUsageCommand}" CommandParameter="{Binding}">
                  <TextBlock Classes="mono" FontSize="11" TextTrimming="PathSegmentEllipsis">
                    <Run Text="{Binding FilePath}"/><Run Text=":"/><Run Text="{Binding Line}"/>
                  </TextBlock>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="{loc:Loc 'HISTORY'}" Classes="section"/>
        <TextBlock Text="{Binding SelectedKeyAuditInfo}" Classes="caption" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
