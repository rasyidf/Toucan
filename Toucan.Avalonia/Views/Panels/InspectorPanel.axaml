<UserControl x:Class="Toucan.Avalonia.Views.Panels.InspectorPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Toucan.Avalonia.Views.Components">
  <Panel>
    <StackPanel IsVisible="{Binding !HasSelectedKeyDetails}" Margin="16,24" Spacing="6">
      <ui:FASymbolIcon Symbol="Tag" FontSize="28" Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Left"/>
      <TextBlock Text="{loc:Loc 'Select a key to see its details, suggestions, and where it\'s used.'}" Classes="caption" TextWrapping="Wrap"/>
    </StackPanel>

    <ScrollViewer IsVisible="{Binding HasSelectedKeyDetails}">
      <StackPanel Margin="12,12,12,12">

        <!-- Key and quick actions -->
        <c:SettingsGroup Margin="0,0,0,14" Header="{loc:Loc 'KEY'}">
          <StackPanel Margin="12,10" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock Text="{Binding SelectedKeyNamespace}" Classes="mono" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="icon small" ToolTip.Tip="{loc:Loc 'Copy key'}" VerticalAlignment="Top"
                      Command="{Binding CopyKeyCommand}" CommandParameter="{Binding SelectedKeyNamespace}">
                <ui:FASymbolIcon Symbol="Copy"/>
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="6">
              <Button Grid.ColumnSpan="2" Content="{loc:Loc 'Translate empty'}" Command="{Binding TranslateSelectedKeyCommand}" Classes="inspectorAction"/>
              <Button Grid.Row="1" Content="{loc:Loc 'Plural forms'}" Command="{Binding GeneratePluralFormsCommand}" Classes="inspectorAction"/>
              <Button Grid.Row="1" Grid.Column="1" Content="{loc:Loc 'Gender forms'}" Command="{Binding GenerateGenderFormsCommand}" Classes="inspectorAction"/>
            </Grid>
          </StackPanel>
        </c:SettingsGroup>

        <!-- Per-language values -->
        <c:SettingsGroup Margin="0,0,0,14" Header="{loc:Loc 'LANGUAGES'}">
          <ItemsControl Classes="rows" ItemsSource="{Binding SelectedKeyLanguages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="itemRow">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="langBadge" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Language}"/></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,8,0" ToolTip.Tip="{Binding Value}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:SettingsGroup>

        <c:SettingsGroup Margin="0,0,0,14" Header="{loc:Loc 'COMMENT'}"
                         IsVisible="{Binding SelectedKeyComment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <SelectableTextBlock Text="{Binding SelectedKeyComment}" TextWrapping="Wrap" FontSize="12" Margin="12,10"/>
        </c:SettingsGroup>

        <c:SettingsGroup Margin="0,0,0,14" Header="{loc:Loc 'TRANSLATION MEMORY'}" IsVisible="{Binding HasMemoryMatches}">
          <ItemsControl Classes="rows" ItemsSource="{Binding MemoryMatches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="itemRow" Padding="0">
                  <Button Classes="row" Padding="12,8" CornerRadius="0" ToolTip.Tip="{loc:Loc 'Insert into the focused field'}"
                          Command="{Binding $parent[UserControl].DataContext.InsertSuggestionCommand}" CommandParameter="{Binding Text}">
                    <StackPanel Spacing="2">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Classes="langBadge" Margin="0,0,8,0" VerticalAlignment="Top"><TextBlock Text="{Binding Label}"/></Border>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Detail}" Classes="hint" MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0"/>
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:SettingsGroup>

        <c:SettingsGroup Margin="0,0,0,14" Header="{loc:Loc 'SIMILAR KEYS'}" IsVisible="{Binding HasSuggestions}">
          <ItemsControl Classes="rows" ItemsSource="{Binding Suggestions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="itemRow" Padding="0">
                  <Button Classes="row" Padding="12,8" CornerRadius="0" ToolTip.Tip="{loc:Loc 'Go to key'}"
                          Command="{Binding $parent[UserControl].DataContext.RevealKeyCommand}" CommandParameter="{Binding Label}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="mono caption" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" MaxLines="2"/>
                      <TextBlock Text="{Binding Detail}" Classes="hint" Margin="0"/>
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:SettingsGroup>

        <c:SettingsGroup Margin="0,0,0,14" Header="{loc:Loc 'USED IN SOURCE'}" IsVisible="{Binding HasSelectedKeyUsages}">
          <ItemsControl Classes="rows" ItemsSource="{Binding SelectedKeyUsages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="itemRow" Padding="0">
                  <Button Classes="row" Padding="12,8" CornerRadius="0" ToolTip.Tip="{Binding LineContent}"
                          Command="{Binding $parent[UserControl].DataContext.OpenUsageCommand}" CommandParameter="{Binding}">
                    <TextBlock Classes="mono" FontSize="11" TextTrimming="PathSegmentEllipsis">
                      <Run Text="{Binding FilePath}"/><Run Text=":"/><Run Text="{Binding Line}"/>
                    </TextBlock>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </c:SettingsGroup>

        <c:SettingsGroup Margin="0,0,0,0" Header="{loc:Loc 'HISTORY'}">
          <SelectableTextBlock Text="{Binding SelectedKeyAuditInfo}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="12,10"/>
        </c:SettingsGroup>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
