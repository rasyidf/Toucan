<Window x:Class="Toucan.Avalonia.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Toucan.Avalonia.Services"
        xmlns:views="using:Toucan.Avalonia.Views"
        xmlns:c="using:Toucan.Avalonia.Views.Components"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="880" MinHeight="560"
        Icon="/Assets/WindowIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ═══ Top bar: in-window menu (Windows/Linux) + view controls ═══ -->
    <Border Grid.Row="0" x:Name="TopBar" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" MinHeight="34">
      <Grid ColumnDefinitions="*,Auto,*" Margin="4,0">
        <!-- Left: (menu on Windows/Linux) · logo and name · save state -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ContentControl x:Name="MenuHost" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="7" Margin="6,0,2,0" VerticalAlignment="Center">
            <Image Source="/Assets/logo.png" Width="18" Height="18"/>
            <TextBlock Text="Toucan" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Classes="saveState" Classes.dirty="{Binding IsDirty}" Command="{Binding SaveCommand}"
                  IsVisible="{Binding HasProject}" ToolTip.Tip="{loc:Loc 'Save now'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Classes="statusDot" Classes.warn="{Binding IsDirty}" Classes.good="{Binding !IsDirty}"/>
              <TextBlock Text="{loc:Loc 'Unsaved'}" IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{loc:Loc 'Saved'}" IsVisible="{Binding !IsDirty}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Center: command palette pill (project and selected key shown while a project is open) -->
        <Button x:Name="PalettePill" Grid.Column="1" Classes="palettePill" Width="380" MinWidth="180" VerticalAlignment="Center"
                Command="{Binding ToggleCommandPaletteCommand}" ToolTip.Tip="{loc:Loc 'Command palette'}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ui:FASymbolIcon Symbol="Find" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
              <TextBlock Text="{loc:Loc 'Search commands…'}" IsVisible="{Binding !HasProject}"/>
              <TextBlock Text="{Binding ProjectName}" IsVisible="{Binding HasProject}" FontWeight="Medium"/>
              <ItemsControl ItemsSource="{Binding SelectedNodePath}" IsVisible="{Binding HasProject}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="›" Margin="6,0" Opacity="0.6"/>
                      <TextBlock Text="{Binding}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border Grid.Column="2" Classes="badge" Margin="8,0,0,0" Padding="5,0">
              <TextBlock x:Name="PaletteShortcut" Classes="mono" FontSize="10"/>
            </Border>
          </Grid>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <!-- Editor mode segmented control -->
          <Border CornerRadius="6" Padding="2" Background="{DynamicResource BadgeBackgroundBrush}" Margin="0,0,8,0"
                  IsVisible="{Binding !ShowStartScreen}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="segment" Classes.active="{Binding IsEditorMode}" Content="{loc:Loc 'Editor'}"
                      Command="{Binding SwitchToEditorModeCommand}" ToolTip.Tip="{loc:Loc 'Edit translations'}"/>
              <Button Classes="segment" Classes.active="{Binding IsReviewMode}" Content="{loc:Loc 'Review'}"
                      Command="{Binding SwitchToReviewModeCommand}" ToolTip.Tip="{loc:Loc 'Approve or reject unreviewed translations'}"/>
              <Button Classes="segment" Classes.active="{Binding IsAuditMode}" Content="{loc:Loc 'Audit'}"
                      Command="{Binding SwitchToAuditModeCommand}" ToolTip.Tip="{loc:Loc 'Read-only view with approval state and history'}"/>
            </StackPanel>
          </Border>
          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Toggle left panel'}"
                  Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleSidebarCommand}"
                  IsVisible="{Binding !ShowStartScreen}">
            <ui:FASymbolIcon Symbol="DockLeft"/>
          </Button>
          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Toggle right panel'}"
                  Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleInspectorCommand}"
                  IsVisible="{Binding !ShowStartScreen}">
            <ui:FASymbolIcon Symbol="DockRight"/>
          </Button>
          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Settings'}" Command="{Binding ShowPreferencesCommand}">
            <ui:FASymbolIcon Symbol="Settings"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Workspace ═══ -->
    <Panel Grid.Row="1">
      <Grid x:Name="Workspace" IsVisible="{Binding !ShowStartScreen}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="46"/>
          <ColumnDefinition Width="280" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="360"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="300" MinWidth="0"/>
          <ColumnDefinition Width="46"/>
        </Grid.ColumnDefinitions>

        <c:ActivityBar Grid.Column="0" x:Name="LeftActivityBar"
                       BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0"/>

        <!-- Left panel host -->
        <DockPanel Grid.Column="1" x:Name="LeftPanelHost">
          <Border DockPanel.Dock="Top" Classes="panelHeader">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="{loc:Loc 'Hide panel'}"
                      Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleSidebarCommand}">
                <ui:FASymbolIcon Symbol="ChevronLeft"/>
              </Button>
              <StackPanel DockPanel.Dock="Right" x:Name="LeftPanelActions" Orientation="Horizontal"/>
              <TextBlock x:Name="LeftPanelTitle" Classes="panelTitle" Text="{loc:Loc 'EXPLORER'}"/>
            </DockPanel>
          </Border>
          <ContentControl x:Name="LeftPanelContent" Classes="panelHost" FontSize="12"/>
        </DockPanel>
        <GridSplitter Grid.Column="2" x:Name="LeftSplitter" Width="4" ResizeDirection="Columns" Background="Transparent"
                      BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0"/>

        <!-- Center editor -->
        <views:TranslationEditorView Grid.Column="3" x:Name="Editor"/>

        <GridSplitter Grid.Column="4" x:Name="RightSplitter" Width="4" ResizeDirection="Columns" Background="Transparent"
                      BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0"/>
        <!-- Right panel host -->
        <DockPanel Grid.Column="5" x:Name="RightPanelHost">
          <Border DockPanel.Dock="Top" Classes="panelHeader">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="{loc:Loc 'Hide panel'}"
                      Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleInspectorCommand}">
                <ui:FASymbolIcon Symbol="ChevronRight"/>
              </Button>
              <StackPanel DockPanel.Dock="Right" x:Name="RightPanelActions" Orientation="Horizontal"/>
              <TextBlock x:Name="RightPanelTitle" Classes="panelTitle" Text="{loc:Loc 'LANGUAGES'}"/>
            </DockPanel>
          </Border>
          <ContentControl x:Name="RightPanelContent" Classes="panelHost" FontSize="12"/>
        </DockPanel>

        <c:ActivityBar Grid.Column="6" x:Name="RightActivityBar"
                       BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0"/>
      </Grid>

      <views:StartScreen IsVisible="{Binding ShowStartScreen}"/>

      <!-- Loading veil -->
      <Border IsVisible="{Binding IsLoading}" Background="#40000000">
        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="220"/>
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding LoadDetail}" IsVisible="{Binding CanCancelLoad}" Opacity="0.6" FontSize="11"
                       Width="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
            <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelLoadCommand}" IsVisible="{Binding CanCancelLoad}"
                    HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Border>
    </Panel>

    <!-- ═══ Status bar ═══ -->
    <c:StatusBarView Grid.Row="2" x:Name="StatusBar"
                     IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=StatusBarVisible}"/>

    <!-- ═══ Zen mode covers everything ═══ -->
    <views:ZenEditorView x:Name="ZenView" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ZenMode}"/>

    <!-- ═══ Command palette overlay (above everything, Zen mode included) ═══ -->
    <c:CommandPalette x:Name="Palette" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsCommandPaletteOpen}"/>
  </Grid>
</Window>
