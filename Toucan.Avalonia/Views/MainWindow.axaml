<Window x:Class="Toucan.Avalonia.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Toucan.Avalonia.Services"
        xmlns:views="using:Toucan.Avalonia.Views"
        xmlns:c="using:Toucan.Avalonia.Views.Components"
        Title="{Binding WindowTitle}"
        Width="1280" Height="820" MinWidth="880" MinHeight="560"
        Icon="/Assets/WindowIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBackgroundBrush}">

  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">

    <!-- ═══ Top bar: in-window menu (Windows/Linux) + view controls ═══ -->
    <Border Grid.Row="0" x:Name="TopBar" MinHeight="40">
      <Grid x:Name="TitleBarLayout" ColumnDefinitions="*,Auto,*" Margin="8,0">
        <!-- Left: (menu on Windows/Linux) · logo and name · save state -->
        <StackPanel x:Name="TitleBarLeading" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <StackPanel x:Name="TitleBarBrand" Orientation="Horizontal" Spacing="7" Margin="6,0,2,0" VerticalAlignment="Center">
            <Image Source="/Assets/logo.png" Width="18" Height="18"/>
            <TextBlock Text="Toucan" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
          <ContentControl x:Name="MenuHost" VerticalAlignment="Center"/>
          <Button x:Name="SaveStateButton" Classes="saveState" Classes.dirty="{Binding IsDirty}" Command="{Binding SaveCommand}"
                  IsVisible="{Binding HasProject}" ToolTip.Tip="{loc:Loc 'Save now'}" AutomationProperties.Name="{loc:Loc 'Save now'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Classes="statusDot" Classes.warn="{Binding IsDirty}" Classes.good="{Binding !IsDirty}"/>
              <TextBlock Text="{loc:Loc 'Unsaved'}" IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{loc:Loc 'Saved'}" IsVisible="{Binding !IsDirty}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Center: command palette pill (project and selected key shown while a project is open) -->
        <Button x:Name="PalettePill" Grid.Column="1" Classes="palettePill" Width="420" MinWidth="180" VerticalAlignment="Center"
                Command="{Binding ToggleCommandPaletteCommand}" ToolTip.Tip="{loc:Loc 'Command palette'}" AutomationProperties.Name="{loc:Loc 'Command palette'}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ui:FASymbolIcon Symbol="Find" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
              <TextBlock Text="{loc:Loc 'Search commands…'}" IsVisible="{Binding !HasProject}"/>
              <TextBlock Text="{Binding ProjectName}" IsVisible="{Binding HasProject}" FontWeight="Medium"/>
              <ItemsControl ItemsSource="{Binding SelectedNodePath}" IsVisible="{Binding HasProject}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="›" Margin="6,0" Opacity="0.6"/>
                      <TextBlock Text="{Binding}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border Grid.Column="2" Classes="badge" Margin="8,0,0,0" Padding="5,0">
              <TextBlock x:Name="PaletteShortcut" Classes="mono" FontSize="10"/>
            </Border>
          </Grid>
        </Button>

        <StackPanel x:Name="TitleBarTrailing" Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel x:Name="WorkspaceModes" Orientation="Horizontal" Spacing="2" Margin="0,0,10,0"
                      IsVisible="{Binding !ShowStartScreen}">
            <Button Classes="modeTab" Classes.active="{Binding IsEditorMode}" Content="{loc:Loc 'Editor'}"
                    Command="{Binding SwitchToEditorModeCommand}" ToolTip.Tip="{loc:Loc 'Edit translations'}"/>
            <Button Classes="modeTab" Classes.active="{Binding IsReviewMode}" Content="{loc:Loc 'Review'}"
                    Command="{Binding SwitchToReviewModeCommand}" ToolTip.Tip="{loc:Loc 'Approve or reject unreviewed translations'}"/>
            <Button Classes="modeTab" Classes.active="{Binding IsAuditMode}" Content="{loc:Loc 'Audit'}"
                    Command="{Binding SwitchToAuditModeCommand}" ToolTip.Tip="{loc:Loc 'Read-only view with approval state and history'}"/>
          </StackPanel>
          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Toggle left panel'}"
                  Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleSidebarCommand}"
                  IsVisible="{Binding !ShowStartScreen}">
            <ui:FASymbolIcon Symbol="DockLeft"/>
          </Button>
          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Toggle right panel'}"
                  Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleInspectorCommand}"
                  IsVisible="{Binding !ShowStartScreen}">
            <ui:FASymbolIcon Symbol="DockRight"/>
          </Button>
          <!-- Windows and Linux: our own window buttons (the system title bar is not drawn). -->
          <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0" IsVisible="False">
            <Button x:Name="MinimizeButton" Classes="caption" ToolTip.Tip="{loc:Loc 'Minimize'}" AutomationProperties.Name="{loc:Loc 'Minimize'}">
              <Path Data="M0,0.5 L10,0.5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Stretch="None"/>
            </Button>
            <Button x:Name="MaximizeButton" Classes="caption" ToolTip.Tip="{loc:Loc 'Maximize'}" AutomationProperties.Name="{loc:Loc 'Maximize'}">
              <Panel>
                <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Stretch="None"/>
                <Path x:Name="RestoreGlyph" Data="M2.5,2.5 L2.5,0.5 L9.5,0.5 L9.5,7.5 L7.5,7.5 M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z" IsVisible="False"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Stretch="None"/>
              </Panel>
            </Button>
            <Button x:Name="CloseButton" Classes="caption close" ToolTip.Tip="{loc:Loc 'Close'}" AutomationProperties.Name="{loc:Loc 'Close'}">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Stretch="None"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Workspace ═══ -->
    <Panel Grid.Row="1" Margin="8,0,8,0">
      <Grid ColumnDefinitions="54,*,Auto">
        <Border Classes="shellSurface" Background="{DynamicResource ChromeBackgroundBrush}" Margin="0,0,6,0">
          <DockPanel>
            <Button x:Name="RailSettings" DockPanel.Dock="Bottom" Classes="activity" Margin="0,3"
                    HorizontalAlignment="Center" ToolTip.Tip="{loc:Loc 'Settings'}" Command="{Binding ShowPreferencesCommand}">
              <ui:FASymbolIcon Symbol="Settings"/>
            </Button>
            <c:ActivityBar x:Name="LeftActivityBar"/>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" x:Name="WorkspaceSurface" Classes="shellSurface">
          <Panel x:Name="WorkspaceContent">
            <Grid x:Name="Workspace" IsVisible="{Binding !ShowStartScreen}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="0"/>
              </Grid.ColumnDefinitions>

              <!-- Left panel host -->
              <DockPanel Grid.Column="0" x:Name="LeftPanelHost">
                <Border DockPanel.Dock="Top" Classes="panelHeader">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="{loc:Loc 'Hide panel'}"
                            Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleSidebarCommand}">
                      <ui:FASymbolIcon Symbol="ChevronLeft"/>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" x:Name="LeftPanelActions" Orientation="Horizontal"/>
                    <TextBlock x:Name="LeftPanelTitle" Classes="panelTitle" Text="{loc:Loc 'EXPLORER'}"/>
                  </DockPanel>
                </Border>
                <ContentControl x:Name="LeftPanelContent" Classes="panelHost" FontSize="12"/>
              </DockPanel>
              <GridSplitter Grid.Column="1" x:Name="LeftSplitter" Width="4" MinWidth="4" ResizeDirection="Columns" Background="Transparent"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0"/>

              <!-- Center editor -->
              <views:TranslationEditorView Grid.Column="2" x:Name="Editor"/>

              <GridSplitter Grid.Column="3" x:Name="RightSplitter" Width="4" MinWidth="4" ResizeDirection="Columns" Background="Transparent"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0"/>
              <!-- Right panel host -->
              <DockPanel Grid.Column="4" x:Name="RightPanelHost">
                <Border DockPanel.Dock="Top" Classes="panelHeader">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="{loc:Loc 'Hide panel'}"
                            Command="{Binding Source={x:Static svc:PanelService.Instance}, Path=ToggleInspectorCommand}">
                      <ui:FASymbolIcon Symbol="ChevronRight"/>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" x:Name="RightPanelActions" Orientation="Horizontal"/>
                    <TextBlock x:Name="RightPanelTitle" Classes="panelTitle" Text="{loc:Loc 'LANGUAGES'}"/>
                  </DockPanel>
                </Border>
                <ContentControl x:Name="RightPanelContent" Classes="panelHost" FontSize="12"/>
              </DockPanel>

            </Grid>

            <views:StartScreen IsVisible="{Binding ShowStartScreen}"/>
          </Panel>
        </Border>
        <Border Grid.Column="2" Classes="shellSurface" Background="{DynamicResource ChromeBackgroundBrush}"
                Width="48" Margin="6,0,0,0" IsVisible="{Binding !ShowStartScreen}">
          <c:ActivityBar x:Name="RightActivityBar" Classes="rightRail"/>
        </Border>
      </Grid>

      <!-- Loading veil -->
      <Border IsVisible="{Binding IsLoading}" Background="#40000000">
        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="220"/>
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding LoadDetail}" IsVisible="{Binding CanCancelLoad}" Opacity="0.6" FontSize="11"
                       Width="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
            <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelLoadCommand}" IsVisible="{Binding CanCancelLoad}"
                    HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Border>
    </Panel>

    <!-- ═══ Status bar ═══ -->
    <c:StatusBarView Grid.Row="2" x:Name="StatusBar"
                     IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=StatusBarVisible}"/>

    <!-- ═══ Zen mode covers everything ═══ -->
    <views:ZenEditorView x:Name="ZenView" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ZenMode}"/>

    <!-- ═══ Command palette overlay (above everything, Zen mode included) ═══ -->
    <c:CommandPalette x:Name="Palette" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsCommandPaletteOpen}"/>
    <c:ShortcutSheet Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsShortcutSheetOpen}"/>
  </Grid>
</Window>
