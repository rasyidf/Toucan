<UserControl x:Class="Toucan.Avalonia.Views.Components.TranslationCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:svc="using:Toucan.Avalonia.Services">
  <UserControl.Resources>
    <!-- One language row: badge · value editor · row actions -->
    <DataTemplate x:Key="RowTemplate">
      <Grid Classes="translationRow" ColumnDefinitions="64,*,Auto" Margin="0,3" IsVisible="{Binding IsLanguageVisible}">
        <Border Classes="langBadge" ToolTip.Tip="{Binding Language, Converter={StaticResource LanguageName}}">
          <TextBlock Text="{Binding Language}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <TextBox Grid.Column="1" Classes="translation" Classes.empty="{Binding IsEmpty}"
                 Text="{Binding Value}"
                 PlaceholderText="Not translated"
                 FlowDirection="{Binding FlowDirection}"
                 IsReadOnly="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsAuditMode}"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,3,0,0" Spacing="1">
          <!-- Machine-translated marker -->
          <ui:FASymbolIcon Symbol="World" FontSize="12" Margin="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource InfoBrush}" IsVisible="{Binding IsMachineTranslated}"
                           ToolTip.Tip="Machine translated — not reviewed yet"/>
          <Button Classes="icon small hoverOnly" Command="{Binding CopyTranslationCommand}" ToolTip.Tip="Copy value">
            <ui:FASymbolIcon Symbol="Copy"/>
          </Button>

          <!-- Comment (Review + Audit, or whenever a comment exists) -->
          <Button Classes="icon small" ToolTip.Tip="Comment">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Source="{x:Static svc:PanelService.Instance}" Path="ShowsCommentButton"/>
                <Binding Path="HasComment"/>
              </MultiBinding>
            </Button.IsVisible>
            <Panel>
              <ui:FASymbolIcon Symbol="Comment"/>
              <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                       IsVisible="{Binding HasComment}"/>
            </Panel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="280" Spacing="6">
                  <TextBlock Text="Comment for translators" Classes="caption"/>
                  <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                           IsReadOnly="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsAuditMode}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Review mode: reject / approve -->
          <Button Classes="icon small" Command="{Binding ClearApprovedCommand}" ToolTip.Tip="Mark as needs review"
                  IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsReviewMode}">
            <ui:FASymbolIcon Symbol="Cancel"/>
          </Button>
          <ToggleButton Classes="icon small" IsChecked="{Binding IsApproved}" ToolTip.Tip="Approve"
                        IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsReviewMode}">
            <ui:FASymbolIcon Symbol="Accept"/>
          </ToggleButton>

          <!-- Approved indicator outside Review mode -->
          <ui:FASymbolIcon Symbol="Accept" FontSize="12" Margin="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource GoodBrush}" ToolTip.Tip="Approved">
            <ui:FASymbolIcon.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsApproved"/>
                <Binding Source="{x:Static svc:PanelService.Instance}" Path="IsNotReviewMode"/>
              </MultiBinding>
            </ui:FASymbolIcon.IsVisible>
          </ui:FASymbolIcon>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Classes="cardFrame">
    <Grid RowDefinitions="Auto,Auto">
      <!-- Dirty marker -->
      <Border Grid.RowSpan="2" Width="3" HorizontalAlignment="Left" Margin="-12,-10,0,-10" CornerRadius="3,0,0,3"
              Background="{DynamicResource DirtyBrush}" IsVisible="{Binding IsDirty}"/>

      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
        <CheckBox x:Name="BulkCheck" IsChecked="{Binding IsSelectedForBulk}" MinWidth="0" Margin="0,0,6,0"
                  IsVisible="{Binding $parent[Window].DataContext.IsMultiSelectMode, FallbackValue=False}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <SelectableTextBlock Classes="mono" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="{Binding ParentPrefix}" Foreground="{DynamicResource FaintTextBrush}"/><Run Text="{Binding ShortName}" FontWeight="SemiBold"/>
          </SelectableTextBlock>
          <Border Classes="badge" IsVisible="{Binding IsPluralGroup}">
            <TextBlock Text="plural"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1">
          <Button Classes="icon small" Command="{Binding TranslateKeyCommand}" ToolTip.Tip="Machine-translate empty values of this key"
                  IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsEditorMode}">
            <ui:FASymbolIcon Symbol="Character"/>
          </Button>
          <Button Classes="icon small" Command="{Binding CopyNamespaceCommand}" ToolTip.Tip="Copy key">
            <ui:FASymbolIcon Symbol="Link"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Single key: one row per language -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Translations}" ItemTemplate="{StaticResource RowTemplate}"
                    IsVisible="{Binding !IsPluralGroup}"/>

      <!-- Plural key: a section per category -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding PluralVariants}" IsVisible="{Binding IsPluralGroup}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2,0,6">
              <TextBlock Text="{Binding Category}" Classes="caption" FontWeight="SemiBold" Margin="0,4,0,2"/>
              <ItemsControl ItemsSource="{Binding Translations}" ItemTemplate="{StaticResource RowTemplate}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
