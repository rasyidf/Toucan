<UserControl x:Class="Toucan.Avalonia.Views.Components.TranslationCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:svc="using:Toucan.Avalonia.Services"
             xmlns:c="using:Toucan.Avalonia.Views.Components">
  <UserControl.Resources>
    <ControlTheme x:Key="LanguageCellTheme" TargetType="ContentPresenter">
      <Setter Property="IsVisible" Value="{Binding IsLanguageVisible}"/>
    </ControlTheme>
    <!-- One language row: badge · value editor · row actions -->
    <DataTemplate x:Key="RowTemplate">
      <Grid Classes="translationRow" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4" IsVisible="{Binding IsLanguageVisible}">
        <Border Classes="langBadge rowLanguage" MinWidth="36" MinHeight="36" MaxWidth="80" ToolTip.Tip="{Binding Language, Converter={StaticResource LanguageName}}">
          <StackPanel>
            <TextBlock Text="{Binding Language}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{loc:Loc 'Source'}" IsVisible="{Binding IsSource}" FontSize="10"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="4">
          <Border Classes="badge" IsVisible="{Binding IsResourceReadOnly}" HorizontalAlignment="Left"><TextBlock Text="{loc:Loc 'Read-only resource'}"/></Border>
          <TextBlock Text="{Binding ReadOnlyReason}" IsVisible="{Binding IsResourceReadOnly}" TextWrapping="Wrap" Classes="caption"/>
          <Expander Header="{loc:Loc 'ARB placeholders'}" IsVisible="{Binding HasArbMetadata}">
            <c:ArbPlaceholderEditor/>
          </Expander>
        </StackPanel>
        <Panel Classes="valueCell" ToolTip.Tip="{Binding EditorDetails}">
          <TextBox x:Name="EditorField" Classes="translation" Classes.empty="{Binding IsEmpty}" Classes.invalid="{Binding HasInlineErrors}"
                   Text="{Binding Value}"
                   PlaceholderText="{Binding PlaceholderText}"
                   AutomationProperties.Name="{Binding Language, Converter={StaticResource LanguageName}}"
                   FlowDirection="{Binding FlowDirection}"
                   IsReadOnly="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsAuditMode}" IsEnabled="{Binding !IsResourceReadOnly}"/>
          <c:SpellingUnderline/>
          <c:PlaceholderHighlight Editor="{Binding #EditorField}" HighlightBrush="{DynamicResource PlaceholderHighlightBrush}"/>
          <!-- Inline TM suggestion (ghost text): shown while the field is empty; Tab accepts -->
          <Grid ColumnDefinitions="*,Auto" IsHitTestVisible="False" Margin="11,0,10,0" VerticalAlignment="Center"
                FlowDirection="{Binding FlowDirection}">
            <Grid.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="HasGhostText"/>
                <Binding Path="IsEmpty"/>
              </MultiBinding>
            </Grid.IsVisible>
            <TextBlock Text="{Binding GhostText}" Opacity="0.5" FontStyle="Italic" FontSize="{DynamicResource EditorFontSize}" TextTrimming="CharacterEllipsis"/>
            <Border Grid.Column="1" Classes="badge" Margin="6,0,0,0">
              <TextBlock Text="{loc:Loc 'Tab to accept'}"/>
            </Border>
          </Grid>
        </Panel>

        <!-- Inline validation under the field (left) and, only while this field has
             focus, the character/word count (right). Takes no space unless there is something to show. -->
        <Grid Grid.Row="3" Grid.ColumnSpan="3" Classes="rowMeta" RowDefinitions="Auto,Auto,Auto" Margin="2,2,2,0">
          <Grid.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
              <Binding Path="HasInlineIssues"/>
              <Binding Path="ShowCount"/>
              <Binding Path="HasPlaceholderWarning"/>
            </MultiBinding>
          </Grid.IsVisible>
          <ItemsControl ItemsSource="{Binding InlineIssues}" IsVisible="{Binding HasInlineIssues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                  <Ellipse Width="6" Height="6" Margin="0,5,5,0" VerticalAlignment="Top"
                           Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                  <TextBlock Grid.Column="1" Classes="caption" TextWrapping="Wrap"
                             Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                             Text="{Binding Message}" AutomationProperties.HelpText="{Binding Message}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Inline warning: a {{ }} placeholder from the source is missing here -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                      IsVisible="{Binding HasPlaceholderWarning}">
            <ui:FASymbolIcon Symbol="Important" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource WarnBrush}"/>
            <TextBlock Classes="caption" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                       Text="{Binding PlaceholderWarning}" ToolTip.Tip="{loc:Loc 'This translation is missing a placeholder from the source'}"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Classes="caption" Foreground="{DynamicResource FaintTextBrush}" FontSize="11"
                     HorizontalAlignment="Right" Margin="0,2,0,0" Text="{Binding CountSummary}"
                     IsVisible="{Binding ShowCount}"/>
        </Grid>
        <StackPanel Classes="valueActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Spacing="1">
          <!-- Machine-translated marker -->
          <ui:FASymbolIcon Symbol="World" FontSize="12" Margin="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource InfoBrush}" IsVisible="{Binding IsMachineTranslated}"
                           ToolTip.Tip="{loc:Loc 'Machine translated — not reviewed yet'}"/>
          <Button Classes="icon small hoverOnly" Command="{Binding CopyTranslationCommand}" ToolTip.Tip="{loc:Loc 'Copy value'}">
            <ui:FASymbolIcon Symbol="Copy"/>
          </Button>

          <!-- Comment (Review + Audit, or whenever a comment exists) -->
          <Button Classes="icon small" ToolTip.Tip="{loc:Loc 'Comment'}">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding Source="{x:Static svc:PanelService.Instance}" Path="ShowsCommentButton"/>
                <Binding Path="HasComment"/>
              </MultiBinding>
            </Button.IsVisible>
            <Panel>
              <ui:FASymbolIcon Symbol="Comment"/>
              <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                       IsVisible="{Binding HasComment}"/>
            </Panel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="280" Spacing="6">
                  <TextBlock Text="{loc:Loc 'Comment for translators'}" Classes="caption"/>
                  <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                           IsReadOnly="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsAuditMode}" IsEnabled="{Binding !IsResourceReadOnly}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Review mode: reject / approve -->
          <Button Classes="icon small" Command="{Binding ClearApprovedCommand}" ToolTip.Tip="{loc:Loc 'Mark as needs review'}"
                  IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsReviewMode}">
            <ui:FASymbolIcon Symbol="Cancel"/>
          </Button>
          <ToggleButton Classes="icon small" IsChecked="{Binding IsApproved}" ToolTip.Tip="{loc:Loc 'Approve'}"
                        IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsReviewMode}">
            <ui:FASymbolIcon Symbol="Accept"/>
          </ToggleButton>

          <!-- Approved indicator outside Review mode -->
          <ui:FASymbolIcon Symbol="Accept" FontSize="12" Margin="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource GoodBrush}" ToolTip.Tip="{loc:Loc 'Approved'}">
            <ui:FASymbolIcon.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsApproved"/>
                <Binding Source="{x:Static svc:PanelService.Instance}" Path="IsNotReviewMode"/>
              </MultiBinding>
            </ui:FASymbolIcon.IsVisible>
          </ui:FASymbolIcon>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Classes="cardFrame">
    <Grid Classes="cardLayout" ColumnDefinitions="180,*" RowDefinitions="Auto,Auto">
      <!-- Dirty marker -->
      <Border Grid.RowSpan="2" Width="3" HorizontalAlignment="Left" Margin="-12,-10,0,-10" CornerRadius="3,0,0,3"
              Background="{DynamicResource DirtyBrush}" IsVisible="{Binding IsDirty}"/>

      <!-- Header -->
      <Grid Classes="cardHeader" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
        <CheckBox x:Name="BulkCheck" IsChecked="{Binding IsSelectedForBulk}" MinWidth="0" Margin="0,0,6,0"
                  IsVisible="{Binding $parent[Window].DataContext.IsMultiSelectMode, FallbackValue=False}"/>
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <SelectableTextBlock Classes="mono" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="{Binding ParentPrefix}" Foreground="{DynamicResource FaintTextBrush}"/><Run Text="{Binding ShortName}" FontWeight="SemiBold"/>
          </SelectableTextBlock>
          <Border Grid.Column="1" Classes="badge" Margin="8,0,0,0" IsVisible="{Binding IsPluralGroup}">
            <TextBlock Text="{loc:Loc 'plural'}"/>
          </Border>
        </Grid>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceOrigins}" IsVisible="{Binding HasSourceOrigins}"
                   Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceOrigins}"/>
        <StackPanel Classes="keyActions" Orientation="Horizontal" Spacing="1">
          <Button Classes="icon small" Click="OnEditClick" ToolTip.Tip="{loc:Loc 'Edit translations'}"
                  AutomationProperties.Name="{loc:Loc 'Edit translations'}"
                  IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsNotAuditMode}">
            <ui:FASymbolIcon Symbol="Edit"/>
          </Button>
          <Button Classes="icon small" Command="{Binding TranslateKeyCommand}" ToolTip.Tip="{loc:Loc 'Machine-translate empty values of this key'}"
                  IsVisible="{Binding Source={x:Static svc:PanelService.Instance}, Path=IsEditorMode}">
            <ui:FASymbolIcon Symbol="Character"/>
          </Button>
          <Button Classes="icon small" Command="{Binding CopyNamespaceCommand}" ToolTip.Tip="{loc:Loc 'Copy key'}">
            <ui:FASymbolIcon Symbol="Link"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Single key: one row per language -->
      <ItemsControl Classes="translationValues" ItemContainerTheme="{StaticResource LanguageCellTheme}" ItemsSource="{Binding Translations}" ItemTemplate="{StaticResource RowTemplate}"
                    IsVisible="{Binding !IsPluralGroup}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[UserControl].ComparisonColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Plural key: a section per category -->
      <ItemsControl Classes="pluralValues" ItemsSource="{Binding PluralVariants}" IsVisible="{Binding IsPluralGroup}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2,0,6">
              <TextBlock Text="{Binding Category}" Classes="caption" FontWeight="SemiBold" Margin="0,4,0,2"/>
              <ItemsControl Classes="translationValues" ItemContainerTheme="{StaticResource LanguageCellTheme}" ItemsSource="{Binding Translations}" ItemTemplate="{StaticResource RowTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[UserControl].ComparisonColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
