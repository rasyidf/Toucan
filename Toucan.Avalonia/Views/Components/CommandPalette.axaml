<UserControl x:Class="Toucan.Avalonia.Views.Components.CommandPalette"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls">
  <!-- Scrim: a click anywhere outside the panel closes the palette. -->
  <Grid x:Name="Scrim" Background="#59000000">
    <Border x:Name="Panel" Width="580" MaxHeight="460" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,52,0,0"
            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="12" ClipToBounds="True" BoxShadow="0 12 40 0 #55000000">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.16" Easing="CubicEaseOut"/>
        </Transitions>
      </Border.Transitions>
      <DockPanel>
        <Grid x:Name="InputRow" DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="14,0" MinHeight="46">
          <ui:FASymbolIcon Symbol="Find" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBox x:Name="Input" Grid.Column="1" Classes="paletteInput" AutomationProperties.Name="{loc:Loc 'Command palette'}" PlaceholderText="{loc:Loc 'Type a command…'}"
                   VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="15"/>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SubtleBorderBrush}"/>

        <TextBlock x:Name="Empty" DockPanel.Dock="Top" Text="{loc:Loc 'No matching commands'}" Classes="caption" HorizontalAlignment="Center" Margin="16,24" IsVisible="False"/>
        <ListBox x:Name="List" Classes="plain paletteList" AutomationProperties.Name="{loc:Loc 'Commands'}" Margin="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Classes.disabled="{Binding !CanRun}" AutomationProperties.Name="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Category}" Classes="caption" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Shortcut}" Classes="mono"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
