<UserControl x:Class="Toucan.Avalonia.Views.TranslationEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Toucan.Avalonia.Views.Components">
  <DockPanel Background="{DynamicResource EditorBackgroundBrush}">

    <!-- ═══ Filter toolbar ═══ -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="FilterBox" Text="{Binding SearchText}" Classes="clearButton"
                 PlaceholderText="{loc:Loc 'Filter keys and values (end with “.” for a key path)'}">
          <TextBox.InnerLeftContent>
            <ui:FASymbolIcon Symbol="Filter" FontSize="14" Margin="8,0,2,0" Foreground="{DynamicResource MutedTextBrush}"/>
          </TextBox.InnerLeftContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ApplySearchCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
          <!-- Quick filters -->
          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Quick filters'}">
            <ui:FASymbolIcon Symbol="Bookmarks"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{loc:Loc 'All keys'}" Command="{Binding ClearFilterCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc 'Untranslated'}" Command="{Binding ShowUntranslatedCommand}"/>
                <MenuItem Header="{loc:Loc 'Needs review'}" Command="{Binding ShowNeedsReviewCommand}"/>
                <MenuItem Header="{loc:Loc 'Approved'}" Command="{Binding ShowApprovedCommand}"/>
                <MenuItem Header="{loc:Loc 'Translated'}" Command="{Binding ShowTranslatedCommand}"/>
                <MenuItem Header="{loc:Loc 'Machine translated'}" Command="{Binding ShowMachineTranslatedCommand}"/>
                <MenuItem Header="{loc:Loc 'Changed this session'}" Command="{Binding ShowChangedThisSessionCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc 'Used in source code'}" Command="{Binding FilterUsedKeysCommand}"/>
                <MenuItem Header="{loc:Loc 'Unused in source code'}" Command="{Binding FilterUnusedKeysCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <!-- Visible languages -->
          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Visible languages'}">
            <ui:FASymbolIcon Symbol="Globe"/>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="6" MinWidth="200" MaxWidth="360">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="link" Content="{loc:Loc 'Show all'}" Command="{Binding ShowAllLanguagesCommand}"/>
                    <TextBlock Text="{loc:Loc 'Visible languages'}" Classes="caption" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding LanguageVisibilityFilter}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Language}" IsChecked="{Binding IsVisible}" Margin="0,0,12,0" MinWidth="80"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <ToggleButton Classes="icon" IsChecked="{Binding IsMultiSelectMode}" ToolTip.Tip="{loc:Loc 'Select multiple keys'}">
            <ui:FASymbolIcon Symbol="SelectAll"/>
          </ToggleButton>
          <ToggleButton Classes="icon" IsChecked="{Binding FocusedEditorMode, Mode=OneWay}" Command="{Binding ToggleFocusedEditorCommand}"
                        ToolTip.Tip="{loc:Loc 'Focused editor: one key at a time'}">
            <ui:FASymbolIcon Symbol="Target"/>
          </ToggleButton>

          <Button Classes="icon" ToolTip.Tip="{loc:Loc 'More actions'}">
            <ui:FASymbolIcon Symbol="More"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{loc:Loc 'Add translation key…'}" Command="{Binding NewItemCommand}"/>
                <MenuItem Header="{loc:Loc 'Pre-translate…'}" Command="{Binding PreTranslateBulkCommand}"/>
                <MenuItem Header="{loc:Loc 'Fill empty values in view'}" Command="{Binding PreTranslateVisibleCommand}"/>
                <MenuItem Header="{loc:Loc 'Approve all in view'}" Command="{Binding ApproveVisibleCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:Loc 'Zen mode'}" Command="{Binding ToggleZenModeCommand}"/>
                <MenuItem Header="{loc:Loc 'Show all items (no paging)'}" Command="{Binding ToggleInfiniteScrollCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Active filter chip ═══ -->
    <Border DockPanel.Dock="Top" Padding="12,6,12,0"
            IsVisible="{Binding ActiveFilterDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Horizontal">
        <Border Classes="badge" Padding="8,2,2,2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding ActiveFilterDescription}" FontSize="11" VerticalAlignment="Center"/>
            <Button Classes="icon small" Padding="2" Command="{Binding ClearFilterCommand}" ToolTip.Tip="{loc:Loc 'Clear filter'}">
              <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ═══ Bulk actions (multi-select) ═══ -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding IsMultiSelectMode}" Margin="12,8,12,0" Padding="8,4"
            CornerRadius="6" Background="{DynamicResource SelectedBackgroundBrush}">
      <WrapPanel>
        <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0"/>
        <Button Classes="link" Content="{loc:Loc 'Select all'}" Command="{Binding BulkSelectAllCommand}"/>
        <Button Classes="link" Content="{loc:Loc 'None'}" Command="{Binding BulkDeselectAllCommand}"/>
        <Button Classes="link" Content="{loc:Loc 'Translate…'}" Command="{Binding BulkTranslateCommand}"/>
        <Button Classes="link" Content="{loc:Loc 'Approve'}" Command="{Binding BulkApproveCommand}"/>
        <Button Classes="link" Content="{loc:Loc 'Copy to language…'}" Command="{Binding BulkCopyToLanguageCommand}"/>
        <Button Classes="link" Content="{loc:Loc 'Move…'}" Command="{Binding BulkMoveToNamespaceCommand}"/>
        <Button Classes="link" Content="{loc:Loc 'Delete…'}" Command="{Binding BulkDeleteCommand}" Foreground="{DynamicResource BadBrush}"/>
        <Button Classes="link" Content="{loc:Loc 'Done'}" Command="{Binding ToggleMultiSelectCommand}"/>
      </WrapPanel>
    </Border>

    <c:PaginationControl DockPanel.Dock="Bottom" IsVisible="{Binding !FocusedEditorMode}"/>

    <Panel>
      <!-- Card list -->
      <ListBox x:Name="CardList" Classes="editor" ItemsSource="{Binding PageData}" SelectedItem="{Binding SelectedGroup}"
               IsVisible="{Binding !FocusedEditorMode}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <c:TranslationCard/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Focused editor: one card at a time -->
      <DockPanel IsVisible="{Binding FocusedEditorMode}">
        <Border DockPanel.Dock="Top" Classes="toolbar">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Content="{loc:Loc 'Exit focused editor'}" Command="{Binding ToggleFocusedEditorCommand}"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="icon small" Command="{Binding FocusedPreviousCommand}" ToolTip.Tip="{loc:Loc 'Previous (K or ↑)'}">
                <ui:FASymbolIcon Symbol="ChevronUp"/>
              </Button>
              <Button Classes="icon small" Command="{Binding FocusedNextCommand}" ToolTip.Tip="{loc:Loc 'Next (J or ↓)'}">
                <ui:FASymbolIcon Symbol="ChevronDown"/>
              </Button>
              <TextBlock Text="{Binding FocusedPositionText}" Classes="caption" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <ScrollViewer>
          <c:TranslationCard DataContext="{Binding ZenCurrentItem}" Margin="24,16" MaxWidth="900"/>
        </ScrollViewer>
      </DockPanel>

      <!-- Empty state -->
      <StackPanel IsVisible="{Binding IsEditorEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <ui:FASymbolIcon Symbol="Find" FontSize="36" Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc 'No keys match'}" FontSize="16" HorizontalAlignment="Center"/>
        <TextBlock Text="{loc:Loc 'Change the filter, or add a new translation key.'}" Classes="caption" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Content="{loc:Loc 'Clear filter'}" Command="{Binding ClearFilterCommand}"/>
          <Button Content="{loc:Loc 'Add key…'}" Classes="accent" Command="{Binding NewItemCommand}"/>
        </StackPanel>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
