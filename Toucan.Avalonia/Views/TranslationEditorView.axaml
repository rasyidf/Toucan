<UserControl x:Class="Toucan.Avalonia.Views.TranslationEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:Toucan.Avalonia.Views.Components">
  <DockPanel Background="{DynamicResource EditorBackgroundBrush}">

    <!-- ═══ Filter toolbar ═══ -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="FilterBox" Text="{Binding SearchText}" Classes="clearButton"
                 PlaceholderText="Filter keys and values (end with “.” for a key path)">
          <TextBox.InnerLeftContent>
            <ui:FASymbolIcon Symbol="Filter" FontSize="14" Margin="8,0,2,0" Foreground="{DynamicResource MutedTextBrush}"/>
          </TextBox.InnerLeftContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ApplySearchCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
          <!-- Quick filters -->
          <Button Classes="icon" ToolTip.Tip="Quick filters">
            <ui:FASymbolIcon Symbol="Bookmarks"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="All keys" Command="{Binding ClearFilterCommand}"/>
                <Separator/>
                <MenuItem Header="Untranslated" Command="{Binding ShowUntranslatedCommand}"/>
                <MenuItem Header="Needs review" Command="{Binding ShowNeedsReviewCommand}"/>
                <MenuItem Header="Approved" Command="{Binding ShowApprovedCommand}"/>
                <MenuItem Header="Translated" Command="{Binding ShowTranslatedCommand}"/>
                <MenuItem Header="Machine translated" Command="{Binding ShowMachineTranslatedCommand}"/>
                <MenuItem Header="Changed this session" Command="{Binding ShowChangedThisSessionCommand}"/>
                <Separator/>
                <MenuItem Header="Used in source code" Command="{Binding FilterUsedKeysCommand}"/>
                <MenuItem Header="Unused in source code" Command="{Binding FilterUnusedKeysCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <!-- Visible languages -->
          <Button Classes="icon" ToolTip.Tip="Visible languages">
            <ui:FASymbolIcon Symbol="Globe"/>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="6" MinWidth="200" MaxWidth="360">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="link" Content="Show all" Command="{Binding ShowAllLanguagesCommand}"/>
                    <TextBlock Text="Visible languages" Classes="caption" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding LanguageVisibilityFilter}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Language}" IsChecked="{Binding IsVisible}" Margin="0,0,12,0" MinWidth="80"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <ToggleButton Classes="icon" IsChecked="{Binding IsMultiSelectMode}" ToolTip.Tip="Select multiple keys">
            <ui:FASymbolIcon Symbol="SelectAll"/>
          </ToggleButton>
          <ToggleButton Classes="icon" IsChecked="{Binding FocusedEditorMode, Mode=OneWay}" Command="{Binding ToggleFocusedEditorCommand}"
                        ToolTip.Tip="Focused editor: one key at a time">
            <ui:FASymbolIcon Symbol="Target"/>
          </ToggleButton>

          <Button Classes="icon" ToolTip.Tip="More actions">
            <ui:FASymbolIcon Symbol="More"/>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Add translation key…" Command="{Binding NewItemCommand}"/>
                <MenuItem Header="Pre-translate…" Command="{Binding PreTranslateBulkCommand}"/>
                <MenuItem Header="Fill empty values in view" Command="{Binding PreTranslateVisibleCommand}"/>
                <MenuItem Header="Approve all in view" Command="{Binding ApproveVisibleCommand}"/>
                <Separator/>
                <MenuItem Header="Zen mode" Command="{Binding ToggleZenModeCommand}"/>
                <MenuItem Header="Show all items (no paging)" Command="{Binding ToggleInfiniteScrollCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Active filter chip ═══ -->
    <Border DockPanel.Dock="Top" Padding="12,6,12,0"
            IsVisible="{Binding ActiveFilterDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Orientation="Horizontal">
        <Border Classes="badge" Padding="8,2,2,2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding ActiveFilterDescription}" FontSize="11" VerticalAlignment="Center"/>
            <Button Classes="icon small" Padding="2" Command="{Binding ClearFilterCommand}" ToolTip.Tip="Clear filter">
              <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ═══ Bulk actions (multi-select) ═══ -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding IsMultiSelectMode}" Margin="12,8,12,0" Padding="8,4"
            CornerRadius="6" Background="{DynamicResource SelectedBackgroundBrush}">
      <WrapPanel>
        <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0"/>
        <Button Classes="link" Content="Select all" Command="{Binding BulkSelectAllCommand}"/>
        <Button Classes="link" Content="None" Command="{Binding BulkDeselectAllCommand}"/>
        <Button Classes="link" Content="Translate…" Command="{Binding BulkTranslateCommand}"/>
        <Button Classes="link" Content="Approve" Command="{Binding BulkApproveCommand}"/>
        <Button Classes="link" Content="Copy to language…" Command="{Binding BulkCopyToLanguageCommand}"/>
        <Button Classes="link" Content="Move…" Command="{Binding BulkMoveToNamespaceCommand}"/>
        <Button Classes="link" Content="Delete…" Command="{Binding BulkDeleteCommand}" Foreground="{DynamicResource BadBrush}"/>
        <Button Classes="link" Content="Done" Command="{Binding ToggleMultiSelectCommand}"/>
      </WrapPanel>
    </Border>

    <c:PaginationControl DockPanel.Dock="Bottom" IsVisible="{Binding !FocusedEditorMode}"/>

    <Panel>
      <!-- Card list -->
      <ListBox x:Name="CardList" Classes="editor" ItemsSource="{Binding PageData}" SelectedItem="{Binding SelectedGroup}"
               IsVisible="{Binding !FocusedEditorMode}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <c:TranslationCard/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Focused editor: one card at a time -->
      <DockPanel IsVisible="{Binding FocusedEditorMode}">
        <Border DockPanel.Dock="Top" Classes="toolbar">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Content="Exit focused editor" Command="{Binding ToggleFocusedEditorCommand}"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="icon small" Command="{Binding FocusedPreviousCommand}" ToolTip.Tip="Previous (K or ↑)">
                <ui:FASymbolIcon Symbol="ChevronUp"/>
              </Button>
              <Button Classes="icon small" Command="{Binding FocusedNextCommand}" ToolTip.Tip="Next (J or ↓)">
                <ui:FASymbolIcon Symbol="ChevronDown"/>
              </Button>
              <TextBlock Text="{Binding FocusedPositionText}" Classes="caption" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <ScrollViewer>
          <c:TranslationCard DataContext="{Binding ZenCurrentItem}" Margin="24,16" MaxWidth="900"/>
        </ScrollViewer>
      </DockPanel>

      <!-- Empty state -->
      <StackPanel IsVisible="{Binding IsEditorEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <ui:FASymbolIcon Symbol="Find" FontSize="36" Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="No keys match" FontSize="16" HorizontalAlignment="Center"/>
        <TextBlock Text="Change the filter, or add a new translation key." Classes="caption" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Content="Clear filter" Command="{Binding ClearFilterCommand}"/>
          <Button Content="Add key…" Classes="accent" Command="{Binding NewItemCommand}"/>
        </StackPanel>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
