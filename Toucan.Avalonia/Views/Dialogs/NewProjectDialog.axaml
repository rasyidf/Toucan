<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.NewProjectDialog"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                Title="New Project" Width="720" Height="600" MinHeight="480">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Classes="caption"
                   x:Name="StepText"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}"/>
          <Button Content="Back" Command="{Binding PreviousStepCommand}" IsVisible="{Binding IsStep1}"/>
          <Button Content="Next" Classes="accent" Command="{Binding NextStepCommand}" IsVisible="{Binding IsStep0}" IsDefault="True"/>
          <Button Content="Create Project" Classes="accent" Command="{Binding CreateCommand}" IsVisible="{Binding IsStep1}"
                  IsEnabled="{Binding IsValid}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Panel Margin="20,18,20,12">
      <!-- Step 1: template, name, folder -->
      <DockPanel IsVisible="{Binding IsStep0}">
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="New project" Classes="dialogTitle"/>
          <TextBlock Text="Pick the framework your app uses. It decides the file format and folder layout." Classes="caption"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <TextBlock Text="Project name" Classes="label"/>
          <TextBox Text="{Binding ProjectName}"/>
          <TextBlock Text="Location" Classes="label"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseFolderCommand}"/>
            <TextBox Text="{Binding ProjectFolder}"/>
          </DockPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Frameworks}" SelectedItem="{Binding SelectedFramework}" Margin="0,12,0,0"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,8,8"/>
              <Setter Property="CornerRadius" Value="6"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="146" Height="72" Padding="10,8" CornerRadius="6" BorderThickness="1"
                      BorderBrush="{DynamicResource CardBorderBrush}">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Icon}" FontSize="16"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" Classes="caption"/>
                  <TextBlock Text="{Binding Style}" Classes="hint mono"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Step 2: languages -->
      <DockPanel IsVisible="{Binding IsStep1}">
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="Languages" Classes="dialogTitle"/>
          <TextBlock Text="Toucan creates one file per language. You can add more later." Classes="caption"/>
          <TextBlock Text="Source language" Classes="label"/>
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SourceLanguage}" MinWidth="200"/>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,8">
            <Button Content="Add language…" Command="{Binding AddLanguageCommand}"/>
            <Button Content="Add suggested languages" Command="{Binding AddDefaultsCommand}"/>
          </StackPanel>
        </StackPanel>
        <Border Classes="card" Padding="4">
          <ListBox Classes="plain" ItemsSource="{Binding Languages}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="Remove"
                          Command="{Binding $parent[ListBox].DataContext.RemoveLanguageCommand}" CommandParameter="{Binding}">
                    <ui:FASymbolIcon Symbol="Dismiss"/>
                  </Button>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="langBadge" Margin="0"><TextBlock Text="{Binding}"/></Border>
                    <TextBlock Text="{Binding Converter={StaticResource LanguageName}}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Panel>
  </DockPanel>
</d:DialogWindow>
