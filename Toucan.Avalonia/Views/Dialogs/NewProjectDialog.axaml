<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.NewProjectDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                xmlns:c="using:Toucan.Avalonia.Views.Components"
                Title="{loc:Loc 'New Project'}" Width="800" Height="680" MinHeight="520">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Classes="caption"
                   x:Name="StepText"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelCommand}"/>
          <Button Content="{loc:Loc 'Back'}" Command="{Binding PreviousStepCommand}" IsVisible="{Binding IsStep1}"/>
          <Button Content="{loc:Loc 'Next'}" Classes="accent" Command="{Binding NextStepCommand}" IsVisible="{Binding IsStep0}" IsDefault="True"/>
          <Button Content="{loc:Loc 'Create Project'}" Classes="accent" Command="{Binding CreateCommand}" IsVisible="{Binding IsStep1}"
                  IsEnabled="{Binding IsValid}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Panel Margin="20,18,20,12">
      <!-- Step 1: template, name, folder -->
      <DockPanel IsVisible="{Binding IsStep0}">
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="{loc:Loc 'New project'}" Classes="dialogTitle"/>
          <TextBlock Text="{loc:Loc 'Pick the framework your app uses. It decides the file format and folder layout.'}" Classes="caption"/>
        </StackPanel>
        <c:SettingsGroup DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <StackPanel>
            <c:SettingsRow Title="{loc:Loc 'Project name'}"><TextBox Text="{Binding ProjectName}" Width="300"/></c:SettingsRow>
            <c:SettingsRow Title="{loc:Loc 'Location'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding ProjectFolder}" Width="300"/>
                <Button Content="{loc:Loc 'Browse…'}" Command="{Binding BrowseFolderCommand}"/>
              </StackPanel>
            </c:SettingsRow>
          </StackPanel>
        </c:SettingsGroup>
        <ListBox ItemsSource="{Binding Frameworks}" SelectedItem="{Binding SelectedFramework}" Margin="0,12,0,0"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,10,10"/>
              <Setter Property="CornerRadius" Value="10"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="fwTile">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Classes="fwBadge" Background="{Binding TileBrush}"><TextBlock Text="{Binding Badge}"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Step 2: languages -->
      <DockPanel IsVisible="{Binding IsStep1}">
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="{loc:Loc 'Languages'}" Classes="dialogTitle"/>
          <TextBlock Text="{loc:Loc 'Toucan creates one file per language. You can add more later.'}" Classes="caption"/>
        </StackPanel>
        <c:SettingsGroup DockPanel.Dock="Top" Margin="0,12,0,12">
          <c:SettingsRow Title="{loc:Loc 'Source language'}">
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SourceLanguage}" MinWidth="200"/>
          </c:SettingsRow>
        </c:SettingsGroup>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button Content="{loc:Loc 'Add language…'}" Command="{Binding AddLanguageCommand}"/>
          <Button Content="{loc:Loc 'Add suggested languages'}" Command="{Binding AddDefaultsCommand}"/>
        </StackPanel>
        <Border Classes="card" Padding="4">
          <ListBox Classes="plain" ItemsSource="{Binding Languages}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="{loc:Loc 'Remove'}"
                          Command="{Binding $parent[ListBox].DataContext.RemoveLanguageCommand}" CommandParameter="{Binding}">
                    <ui:FASymbolIcon Symbol="Dismiss"/>
                  </Button>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="langBadge" Margin="0"><TextBlock Text="{Binding}"/></Border>
                    <TextBlock Text="{Binding Converter={StaticResource LanguageName}}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Panel>
  </DockPanel>
</d:DialogWindow>
