<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.NewProjectDialog"
                xmlns="https://github.com/avaloniaui"
                xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                xmlns:c="using:Toucan.Avalonia.Views.Components"
                Title="{loc:Loc 'New Project'}" Width="920" Height="720" MinWidth="800" MinHeight="520">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="24,22,24,18" Spacing="6">
      <TextBlock Text="{loc:Loc 'New project'}" Classes="dialogTitle" IsVisible="{Binding IsStep0}"/>
      <TextBlock Text="{loc:Loc 'Languages'}" Classes="dialogTitle" IsVisible="{Binding IsStep1}"/>
      <TextBlock Text="{loc:Loc 'Pick the framework your app uses. It decides the file format and folder layout.'}"
                 Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsStep0}"/>
      <TextBlock Text="{loc:Loc 'Toucan creates one file per language. You can add more later.'}"
                 Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsStep1}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Panel Margin="24,0,24,20">
        <StackPanel IsVisible="{Binding IsStep0}" Spacing="18">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Loc 'Project details'}" FontWeight="SemiBold"/>
            <Border Classes="card" Padding="16">
              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="16">
                <TextBlock Text="{loc:Loc 'Project name'}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding ProjectName}" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="1" Text="{loc:Loc 'Location'}" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding ProjectFolder}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding ProjectFolder}"/>
                  <Button Grid.Column="1" Content="{loc:Loc 'Browse…'}" Command="{Binding BrowseFolderCommand}"/>
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Loc 'Framework'}" FontWeight="SemiBold"/>
            <ListBox x:Name="FrameworkSelector" ItemsSource="{Binding Frameworks}" SelectedItem="{Binding SelectedFramework}"
                     Background="Transparent" Padding="0" Margin="-5"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="5"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="CornerRadius" Value="10"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="Transparent"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate><c:FrameworkCard/></DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsStep1}" Spacing="18">
          <Border Classes="card" Padding="16">
            <Grid ColumnDefinitions="140,*" ColumnSpacing="16">
              <TextBlock Text="{loc:Loc 'Source language'}" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SourceLanguage}" HorizontalAlignment="Stretch"/>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Loc 'Add language…'}" Command="{Binding AddLanguageCommand}"/>
            <Button Content="{loc:Loc 'Add suggested languages'}" Command="{Binding AddDefaultsCommand}"/>
          </StackPanel>
          <Border Classes="card" Padding="4">
            <ListBox Classes="plain" ItemsSource="{Binding Languages}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="{loc:Loc 'Remove'}"
                            Command="{Binding $parent[ListBox].DataContext.RemoveLanguageCommand}" CommandParameter="{Binding}">
                      <ui:FASymbolIcon Symbol="Dismiss"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <Border Classes="langBadge" Margin="0"><TextBlock Text="{Binding}"/></Border>
                      <TextBlock Text="{Binding Converter={StaticResource LanguageName}}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>
      </Panel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="dialogFooter">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" Classes="caption" x:Name="StepText"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelCommand}"/>
          <Button Content="{loc:Loc 'Back'}" Command="{Binding PreviousStepCommand}" IsVisible="{Binding IsStep1}"/>
          <Button Content="{loc:Loc 'Next'}" Classes="accent" Command="{Binding NextStepCommand}" IsVisible="{Binding IsStep0}" IsDefault="{Binding IsStep0}" IsEnabled="{Binding IsValid}"/>
          <Button Content="{loc:Loc 'Create Project'}" Classes="accent" Command="{Binding CreateCommand}" IsVisible="{Binding IsStep1}"
                  IsEnabled="{Binding IsValid}" IsDefault="{Binding IsStep1}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</d:DialogWindow>
