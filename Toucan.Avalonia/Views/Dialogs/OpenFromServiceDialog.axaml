<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.OpenFromServiceDialog"
                xmlns="https://github.com/avaloniaui"
                xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                Title="{loc:Loc 'Open from a service'}" Width="760" Height="680" MinWidth="620" MinHeight="560">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="24,22,24,18" Spacing="6">
      <TextBlock Text="{loc:Loc 'Open from a service'}" Classes="dialogTitle"/>
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="{loc:Loc 'Toucan makes a local folder for the project and brings its files in. Afterwards it is an ordinary project; use the Sources panel to pull and push.'}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,0,24,20" Spacing="18">
        <Border Classes="card" Padding="16" IsVisible="{Binding HasNoServices}">
          <TextBlock TextWrapping="Wrap" Text="{loc:Loc 'No installed service can open a project this way. Install a connector plugin, such as Crowdin.'}"/>
        </Border>

        <StackPanel Spacing="10" IsVisible="{Binding HasServices}">
          <TextBlock Text="{loc:Loc 'Service and account'}" FontWeight="SemiBold"/>
          <Border Classes="card" Padding="16">
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="14" ColumnSpacing="16">
              <TextBlock Text="{loc:Loc 'Service'}" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{loc:Loc 'Service'}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Descriptor.DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Text="{loc:Loc 'Account'}" VerticalAlignment="Center"/>
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch" PlaceholderText="{loc:Loc 'Not signed in'}"
                          AutomationProperties.Name="{loc:Loc 'Account'}">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="{loc:Loc 'Sign in…'}" Command="{Binding SignInCommand}"/>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding HasServices}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Content="{loc:Loc 'Refresh'}" Command="{Binding RefreshCommand}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{loc:Loc 'Project'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <ui:FAProgressRing IsIndeterminate="True" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsLoading}"
                                 AutomationProperties.Name="{loc:Loc 'Loading projects'}"/>
            </StackPanel>
          </DockPanel>
          <Border Classes="card" Padding="4" MinHeight="150">
            <Panel>
              <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" TextWrapping="Wrap"
                         Text="{loc:Loc 'Sign in to see your projects.'}" IsVisible="{Binding HasNoAccount}"/>
              <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                         Text="{loc:Loc 'No projects to show.'}" IsVisible="{Binding ShowsNoProjects}"/>
              <ListBox Classes="plain" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" MaxHeight="230"
                       AutomationProperties.Name="{loc:Loc 'Projects'}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4,4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Description}" Classes="caption" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding HasServices}">
          <TextBlock Text="{loc:Loc 'Local folder'}" FontWeight="SemiBold"/>
          <Border Classes="card" Padding="16">
            <Grid ColumnDefinitions="140,*" ColumnSpacing="16">
              <TextBlock Text="{loc:Loc 'Location'}" VerticalAlignment="Center"/>
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="FolderBox" Text="{Binding Folder, Mode=OneWay}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Folder}"
                         AutomationProperties.Name="{loc:Loc 'Location'}"/>
                <Button Grid.Column="1" Content="{loc:Loc 'Browse…'}" Command="{Binding BrowseCommand}"/>
              </Grid>
            </Grid>
          </Border>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{loc:Loc 'Toucan creates this folder and brings the project\'s files in. It must be new or empty.'}"/>
        </StackPanel>

        <Border Classes="card" Padding="12,10" IsVisible="{Binding HasProblem}" BorderBrush="{DynamicResource BadBrush}">
          <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2">
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}" Maximum="100" Height="3" MinHeight="0"
                   AutomationProperties.Name="{loc:Loc 'Opening the project'}"/>
      <Border Classes="dialogFooter">
        <DockPanel>
          <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Text="{Binding StatusText}" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" IsEnabled="{Binding !IsBusy}"/>
            <Button Classes="accent" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" IsDefault="True">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FAProgressRing IsIndeterminate="True" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
                <TextBlock Text="{Binding OpenText}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </Grid>
</d:DialogWindow>
