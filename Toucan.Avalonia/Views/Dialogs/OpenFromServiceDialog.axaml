<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.OpenFromServiceDialog"
                xmlns="https://github.com/avaloniaui"
                xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                Title="{loc:Loc 'Open from a service'}" Width="640" Height="660" MinWidth="520" MinHeight="520">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding StatusText}" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True"/>
          <Button Content="{loc:Loc 'Open project'}" Classes="accent" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" IsDefault="True"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Margin="20,18,20,12">
      <StackPanel Spacing="10">
        <TextBlock Text="{loc:Loc 'Open from a service'}" Classes="dialogTitle"/>
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="{loc:Loc 'Toucan makes a local folder for the project and brings its files in. Afterwards it is an ordinary project; use the Sources panel to pull and push.'}"/>
        <TextBlock Text="{loc:Loc 'No installed service can open a project this way. Install a connector plugin, such as Crowdin.'}" Classes="caption" TextWrapping="Wrap"
                   IsVisible="{Binding HasNoServices}"/>

        <TextBlock Text="{loc:Loc 'Service'}" Classes="groupHeader"/>
        <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Loc 'Service'}">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Descriptor.DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="{loc:Loc 'Account'}" Classes="groupHeader"/>
        <Grid ColumnDefinitions="*,Auto">
          <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch" PlaceholderText="{loc:Loc 'Not signed in'}"
                    AutomationProperties.Name="{loc:Loc 'Account'}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Content="{loc:Loc 'Sign in…'}" Command="{Binding SignInCommand}" Margin="8,0,0,0"/>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{loc:Loc 'Project'}" Classes="groupHeader"/>
          <Button Grid.Column="1" Classes="link" Content="{loc:Loc 'Refresh'}" Command="{Binding RefreshCommand}"/>
        </Grid>
        <ListBox Classes="plain" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" MinHeight="140" MaxHeight="220" AutomationProperties.Name="{loc:Loc 'Projects'}">
          <ListBox.ItemTemplate><DataTemplate>
            <StackPanel Margin="0,4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="caption"/></StackPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="{loc:Loc 'Local folder'}" Classes="groupHeader"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="FolderBox" Text="{Binding Folder, Mode=OneWay}" AutomationProperties.Name="{loc:Loc 'Local folder'}"/>
          <Button Grid.Column="1" Content="{loc:Loc 'Browse…'}" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}"
                   AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</d:DialogWindow>
