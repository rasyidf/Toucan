<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.ProjectPropertiesDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:vm="using:Toucan.Avalonia.ViewModels"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                xmlns:c="using:Toucan.Avalonia.Views.Components"
                Title="{loc:Loc 'Project Properties'}" Width="820" Height="600" MinHeight="460">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <Button Content="{loc:Loc 'Reset to defaults'}" Command="{Binding ResetToDefaultsCommand}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelCommand}"/>
          <Button Content="{loc:Loc 'Save'}" Classes="accent" Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Left" Width="220" Background="{DynamicResource EditorBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12" Spacing="2">
          <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding SaveStyleName}" Classes="caption"/>
        </StackPanel>
        <ListBox x:Name="Nav" Classes="settingsNav" SelectedIndex="0" ItemsSource="{x:Static vm:ProjectPropertiesViewModel.NavEntries}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Border Classes="navTile" Background="{Binding TileBrush}">
                  <ui:FASymbolIcon Symbol="{Binding Icon, Converter={StaticResource Symbol}}"/>
                </Border>
                <TextBlock Text="{Binding Title, Converter={x:Static loc:LocConverter.Instance}}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Background="{DynamicResource ChromeBackgroundBrush}">
      <Panel Margin="32,24" MaxWidth="600">

        <!-- General -->
        <StackPanel IsVisible="{Binding #Nav.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=0}">
          <TextBlock Text="{loc:Loc 'General'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Name'}"><TextBox Text="{Binding ProjectName}"/></c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Description'}" Stacked="True">
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                         PlaceholderText="{loc:Loc 'What is this project for?'}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup Header="{loc:Loc 'Files'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Folder'}">
                <SelectableTextBlock Text="{Binding ProjectPath}" Classes="mono caption" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding ProjectPath}" TextAlignment="Right"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'File format'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding SaveStyleName}" VerticalAlignment="Center"/>
                  <Border Classes="badge" IsVisible="{Binding FormatEditingLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding FormatEditingLabel}" FontSize="11"/>
                  </Border>
                </StackPanel>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Not kept when saving'}" Stacked="True" IsVisible="{Binding HasFormatLimitations}">
                <TextBlock Text="{Binding FormatLimitations}" Classes="caption" TextWrapping="Wrap"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup Header="{loc:Loc 'Languages'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Source language'}">
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding PrimaryLanguage}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Project languages'}" Description="{Binding LanguageSummary}">
                <Button Content="{loc:Loc 'Manage…'}" Command="{Binding ManageLanguagesCommand}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup Header="{loc:Loc 'Saving'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Auto-save'}"><ToggleSwitch IsChecked="{Binding AutoSaveEnabled}"/></c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Every'}" IsVisible="{Binding AutoSaveEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding AutoSaveInterval}" Minimum="10" Maximum="600" Increment="10" FormatString="0"/>
                  <TextBlock Text="{loc:Loc 'seconds'}" VerticalAlignment="Center"/>
                </StackPanel>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Validate before saving'}"><ToggleSwitch IsChecked="{Binding ValidateOnSave}"/></c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
        </StackPanel>

        <!-- Translation -->
        <StackPanel IsVisible="{Binding #Nav.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=1}">
          <TextBlock Text="{loc:Loc 'Translation'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Default provider'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{x:Static vm:ProjectPropertiesViewModel.ProviderOptions}" SelectedItem="{Binding DefaultProvider}"/>
                  <Button Content="{loc:Loc 'Provider settings…'}" Command="{Binding OpenProviderSettingsCommand}"/>
                </StackPanel>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Formality'}">
                <ComboBox ItemsSource="{x:Static vm:ProjectPropertiesViewModel.FormalityOptions}" SelectedItem="{Binding Formality}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Preserve placeholders'}"><ToggleSwitch IsChecked="{Binding PreservePlaceholders}"/></c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Preview before applying machine translations'}"><ToggleSwitch IsChecked="{Binding PreviewBeforeApply}"/></c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup>
            <c:SettingsRow Title="{loc:Loc 'Application context'}" Stacked="True"
                           Description="{loc:Loc 'What does this app do? Helps AI providers choose terminology.'}">
              <TextBox Text="{Binding Context}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"/>
            </c:SettingsRow>
          </c:SettingsGroup>
        </StackPanel>

        <!-- Editor -->
        <StackPanel IsVisible="{Binding #Nav.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=2}">
          <TextBlock Text="{loc:Loc 'Editor'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Write empty translations to files'}"><ToggleSwitch IsChecked="{Binding SaveEmptyTranslations}"/></c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Enable comments'}"><ToggleSwitch IsChecked="{Binding CommentsEnabled}"/></c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Key order in files'}">
                <ComboBox ItemsSource="{x:Static vm:ProjectPropertiesViewModel.TranslationOrderOptions}" SelectedItem="{Binding TranslationOrder}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsList Header="{loc:Loc 'Copy templates (%1 = key)'}" ItemsSource="{Binding CopyTemplates}" AddText="{loc:Loc 'Add template'}" AddCommand="{Binding AddCopyTemplateCommand}" ShowSearch="False" CanAdd="{Binding CanAddCopyTemplate}">
              <c:SettingsList.ItemTemplate>
                  <DataTemplate>
                    <c:SettingsRow Stacked="True">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon small" Margin="6,0,0,0"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveCopyTemplateCommand}" CommandParameter="{Binding}">
                          <ui:FASymbolIcon Symbol="Dismiss"/>
                        </Button>
                        <TextBox Text="{Binding Value}" Classes="mono"/>
                      </DockPanel>
                    </c:SettingsRow>
                  </DataTemplate>
                </c:SettingsList.ItemTemplate>
          </c:SettingsList>
        </StackPanel>

        <!-- Source code -->
        <StackPanel IsVisible="{Binding #Nav.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=3}">
          <TextBlock Text="{loc:Loc 'Source code'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <c:SettingsRow Title="{loc:Loc 'Scan when the project opens'}"><ToggleSwitch IsChecked="{Binding AutoScanOnOpen}"/></c:SettingsRow>
          </c:SettingsGroup>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Source folders (relative, separated by ;)'}" Stacked="True">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{loc:Loc 'Add…'}" Margin="6,0,0,0" Command="{Binding BrowseSourceRootCommand}"/>
                  <TextBox Text="{Binding SourceRoots}" Classes="mono"/>
                </DockPanel>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'File extensions'}" Stacked="True">
                <TextBox Text="{Binding ScanExtensions}" Classes="mono" PlaceholderText="{loc:Loc 'Uses the defaults from Settings when empty'}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Excluded folders'}" Stacked="True">
                <TextBox Text="{Binding ExcludedDirectories}" Classes="mono" PlaceholderText="{loc:Loc 'Uses the defaults from Settings when empty'}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'External editor command'}" Stacked="True">
                <TextBox Text="{Binding ExternalEditor}" Classes="mono" PlaceholderText="code --goto &quot;{file}:{line}&quot;"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
        </StackPanel>

        <!-- Hidden -->
        <StackPanel IsVisible="{Binding #Nav.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=4}">
          <TextBlock Text="{loc:Loc 'Hidden'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <ItemsControl Classes="rows" ItemsSource="{Binding HiddenNamespaces}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <c:SettingsRow Compact="True" Title="{Binding}">
                      <Button Classes="link" Content="{loc:Loc 'Unhide'}"
                              Command="{Binding $parent[ItemsControl].DataContext.RemoveHiddenNamespaceCommand}" CommandParameter="{Binding}"/>
                    </c:SettingsRow>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <c:SettingsRow Title="{loc:Loc 'Nothing is hidden.'}" IsVisible="{Binding !HiddenNamespaces.Count}"/>
            </StackPanel>
          </c:SettingsGroup>
          <TextBlock Classes="groupFooter" Text="{loc:Loc 'Namespaces hidden from the explorer and editor. They are still saved.'}"/>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</d:DialogWindow>
