<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.StatisticsDialog"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                Title="Statistics" Width="620" Height="600">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <Button Content="Close" HorizontalAlignment="Right" x:Name="CloseButton" IsDefault="True"/>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,8" Spacing="4">
      <TextBlock Text="Overview" Classes="dialogTitle"/>
      <TextBlock Text="{Binding Summary}" Classes="caption"/>
      <UniformGrid Columns="4" Margin="0,12,0,0">
        <Border Classes="card" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="{Binding OverallPercentText}" FontSize="22" FontWeight="Bold" Foreground="{Binding OverallPercent, Converter={StaticResource HealthBrush}}"/>
            <TextBlock Text="Complete" Classes="caption"/>
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,8,0">
          <StackPanel><TextBlock Text="{Binding TotalKeys}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Keys" Classes="caption"/></StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,8,0">
          <StackPanel><TextBlock Text="{Binding TotalLanguages}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Languages" Classes="caption"/></StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel><TextBlock Text="{Binding TotalApproved}" FontSize="22" FontWeight="Bold"/><TextBlock Text="Approved" Classes="caption"/></StackPanel>
        </Border>
      </UniformGrid>
      <TextBlock Text="Per language" FontWeight="SemiBold" Margin="0,16,0,0"/>
    </StackPanel>
    <ScrollViewer Margin="20,0,20,16">
      <ItemsControl ItemsSource="{Binding Languages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Margin="0,0,0,8" Padding="12,8">
              <StackPanel Spacing="4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontWeight="SemiBold"
                             Foreground="{Binding Percent, Converter={StaticResource HealthBrush}}"/>
                  <TextBlock>
                    <Run Text="{Binding Language}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding DisplayName}" Foreground="{DynamicResource MutedTextBrush}"/>
                  </TextBlock>
                </DockPanel>
                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" MinHeight="4"
                             Foreground="{Binding Percent, Converter={StaticResource HealthBrush}}"/>
                <TextBlock Classes="caption">
                  <Run Text="{Binding Translated}"/><Run Text=" translated · "/><Run Text="{Binding Missing}"/><Run Text=" missing · "/><Run Text="{Binding Approved}"/><Run Text=" approved"/>
                </TextBlock>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</d:DialogWindow>
