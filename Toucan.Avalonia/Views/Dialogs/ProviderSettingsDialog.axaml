<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.ProviderSettingsDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                Title="{loc:Loc 'Translation Providers'}" Width="840" Height="600">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc 'Close'}" Command="{Binding CloseCommand}"/>
          <Button Content="{loc:Loc 'Save'}" Command="{Binding SaveCommand}"/>
          <Button Content="{loc:Loc 'Save &amp; Close'}" Classes="accent" Command="{Binding SaveAndCloseCommand}" IsDefault="True"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Scope -->
    <Border DockPanel.Dock="Top" Padding="20,16,20,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
          <Button Content="{loc:Loc 'App-wide'}" Command="{Binding LoadAppSettingsCommand}"/>
          <Button Content="{loc:Loc 'Project…'}" Command="{Binding LoadProjectSettingsCommand}"/>
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc 'Translation providers'}" Classes="dialogTitle"/>
          <TextBlock Classes="caption">
            <Run Text="{loc:Loc 'Editing: '}"/><Run Text="{Binding ScopeLabel}" FontWeight="SemiBold"/>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="220,*" Margin="20,4,20,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Content="{loc:Loc 'Add custom'}" Command="{Binding AddProviderCommand}"/>
          <Button Content="{loc:Loc 'Remove'}" Command="{Binding RemoveSelectedCommand}"/>
        </StackPanel>
        <Border Classes="card" Padding="2">
          <ListBox Classes="plain" ItemsSource="{Binding Providers}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Provider}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
        <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding SelectedDefinition.DisplayName, FallbackValue='Custom provider'}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SelectedDefinition.Description}" Classes="caption" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <TextBlock Text="{loc:Loc 'Provider name'}" Classes="label"/>
          <TextBox Text="{Binding Selected.Provider}" IsReadOnly="{Binding SelectedDefinition, Converter={x:Static ObjectConverters.IsNotNull}}"/>

          <DockPanel Margin="0,16,0,4">
            <Button DockPanel.Dock="Right" Classes="link" Content="{loc:Loc 'Add option'}" Command="{Binding AddOptionCommand}"/>
            <TextBlock Text="{loc:Loc 'Options'}" FontWeight="SemiBold"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding OptionItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="160,*,Auto" Margin="0,3">
                  <TextBox Text="{Binding Key}" IsReadOnly="{Binding IsSchemaField}" Classes="mono" Margin="0,0,6,0"/>
                  <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="{Binding Hint}"/>
                  <Button Grid.Column="2" Classes="icon small" IsVisible="{Binding !IsSchemaField}"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveOptionCommand}" CommandParameter="{Binding}">
                    <ui:FASymbolIcon Symbol="Dismiss"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <DockPanel Margin="0,16,0,4">
            <Button DockPanel.Dock="Right" Classes="link" Content="{loc:Loc 'Add secret'}" Command="{Binding AddSecretCommand}"/>
            <TextBlock Text="{loc:Loc 'Secrets (stored encrypted)'}" FontWeight="SemiBold"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding SecretItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="160,*,Auto" Margin="0,3">
                  <TextBox Text="{Binding Key}" IsReadOnly="{Binding IsSchemaField}" Classes="mono" Margin="0,0,6,0"/>
                  <TextBox Grid.Column="1" Text="{Binding Value}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="{Binding Hint}"/>
                  <Button Grid.Column="2" Classes="icon small" IsVisible="{Binding !IsSchemaField}"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveSecretCommand}" CommandParameter="{Binding}">
                    <ui:FASymbolIcon Symbol="Dismiss"/>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</d:DialogWindow>
