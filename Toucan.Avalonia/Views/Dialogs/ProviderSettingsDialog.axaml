<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.ProviderSettingsDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                xmlns:c="using:Toucan.Avalonia.Views.Components"
                Title="{loc:Loc 'Translation Providers'}" Width="840" Height="600">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc 'Close'}" Command="{Binding CloseCommand}"/>
          <Button Content="{loc:Loc 'Save'}" Command="{Binding SaveCommand}"/>
          <Button Content="{loc:Loc 'Save &amp; Close'}" Classes="accent" Command="{Binding SaveAndCloseCommand}" IsDefault="True"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Scope -->
    <Border DockPanel.Dock="Top" Padding="20,16,20,8">
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="{DynamicResource SubtleHoverBrush}" CornerRadius="8" Padding="2" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal">
            <Button Classes="segment" Classes.active="{Binding !ProjectScope}" Content="{loc:Loc 'App-wide'}" Command="{Binding LoadAppSettingsCommand}"/>
            <Button Classes="segment" Classes.active="{Binding ProjectScope}" Content="{loc:Loc 'Project…'}" Command="{Binding LoadProjectSettingsCommand}"/>
          </StackPanel>
        </Border>
        <StackPanel Spacing="2">
          <TextBlock Text="{loc:Loc 'Translation providers'}" Classes="dialogTitle"/>
          <TextBlock Classes="caption">
            <Run Text="{loc:Loc 'Editing: '}"/><Run Text="{Binding ScopeLabel}" FontWeight="SemiBold"/>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="220,*" Margin="20,4,20,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="{loc:Loc 'Add custom'}" Command="{Binding AddProviderCommand}"/>
          <Button Content="{loc:Loc 'Remove'}" Command="{Binding RemoveSelectedCommand}"/>
        </StackPanel>
        <Border Classes="card" Padding="4">
          <ListBox Classes="plain" ItemsSource="{Binding Providers}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Provider}" Margin="4,2"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <ScrollViewer Grid.Column="1" Margin="20,0,0,0">
        <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding SelectedDefinition.DisplayName, FallbackValue='Custom provider'}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SelectedDefinition.Description}" Classes="caption" TextWrapping="Wrap" Margin="0,2,0,16"/>

          <c:SettingsGroup>
            <c:SettingsRow Title="{loc:Loc 'Provider name'}">
              <TextBox Text="{Binding Selected.Provider}"
                       IsReadOnly="{Binding SelectedDefinition, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </c:SettingsRow>
          </c:SettingsGroup>

          <c:SettingsList Header="{loc:Loc 'Options'}" ItemsSource="{Binding OptionItems}" AddText="{loc:Loc 'Add option'}" AddCommand="{Binding AddOptionCommand}" ShowSearch="False">
              <c:SettingsList.ItemTemplate>
                  <DataTemplate>
                    <c:SettingsRow Stacked="True">
                      <Grid ColumnDefinitions="150,*,Auto">
                        <TextBox Text="{Binding Key}" IsReadOnly="{Binding IsSchemaField}" Classes="mono" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="{Binding Hint}"/>
                        <Button Grid.Column="2" Classes="icon small" Margin="6,0,0,0" IsVisible="{Binding !IsSchemaField}"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveOptionCommand}" CommandParameter="{Binding}">
                          <ui:FASymbolIcon Symbol="Dismiss"/>
                        </Button>
                      </Grid>
                    </c:SettingsRow>
                  </DataTemplate>
                </c:SettingsList.ItemTemplate>
          </c:SettingsList>

          <c:SettingsList Header="{loc:Loc 'Secrets (stored encrypted)'}" ItemsSource="{Binding SecretItems}" AddText="{loc:Loc 'Add secret'}" AddCommand="{Binding AddSecretCommand}" ShowSearch="False">
              <c:SettingsList.ItemTemplate>
                  <DataTemplate>
                    <c:SettingsRow Stacked="True">
                      <Grid ColumnDefinitions="150,*,Auto">
                        <TextBox Text="{Binding Key}" IsReadOnly="{Binding IsSchemaField}" Classes="mono" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="{Binding Hint}"/>
                        <Button Grid.Column="2" Classes="icon small" Margin="6,0,0,0" IsVisible="{Binding !IsSchemaField}"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveSecretCommand}" CommandParameter="{Binding}">
                          <ui:FASymbolIcon Symbol="Dismiss"/>
                        </Button>
                      </Grid>
                    </c:SettingsRow>
                  </DataTemplate>
                </c:SettingsList.ItemTemplate>
          </c:SettingsList>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</d:DialogWindow>
