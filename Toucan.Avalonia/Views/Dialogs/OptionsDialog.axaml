<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.OptionsDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:vm="using:Toucan.Avalonia.ViewModels"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                xmlns:c="using:Toucan.Avalonia.Views.Components"
                xmlns:conv="using:Toucan.Avalonia.Converters"
                Title="{loc:Loc 'Settings'}" Width="900" Height="720" MinWidth="720" MinHeight="480">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelCommand}"/>
        <Button Content="{loc:Loc 'Save'}" Classes="accent" Command="{Binding SaveCommand}" IsDefault="True"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Left" Width="220" Background="{DynamicResource EditorBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
      <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="12,12,12,4" Classes="clearButton"
               Text="{Binding SearchText}" PlaceholderText="{loc:Loc 'Search settings'}">
        <TextBox.InnerLeftContent>
          <ui:FASymbolIcon Symbol="Find" FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource FaintTextBrush}"/>
        </TextBox.InnerLeftContent>
      </TextBox>
      <ListBox Classes="settingsNav" Margin="0,8" ItemsSource="{x:Static vm:OptionsViewModel.NavEntries}" SelectedIndex="{Binding SelectedPageIndex}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Border Classes="navTile" Background="{Binding TileBrush}">
                <ui:FASymbolIcon Symbol="{Binding Icon, Converter={StaticResource Symbol}}"/>
              </Border>
              <TextBlock Text="{Binding Title, Converter={x:Static loc:LocConverter.Instance}}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Background="{DynamicResource ChromeBackgroundBrush}">
      <Panel>
      <TextBlock IsVisible="{Binding HasNoSearchResults}" Text="{loc:Loc 'No settings found'}" Classes="caption"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0"/>
      <StackPanel Margin="32,24" MaxWidth="600" x:Name="PagesPanel">

        <!-- 0 General -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="0">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'General'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Reopen the last project on startup'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding OpenLastProjectOnStartup}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Interface language'}" Description="{loc:Loc 'Takes effect after restarting Toucan.'}">
                <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.AppLanguageOptions}" SelectedItem="{Binding SelectedAppLanguage}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup Header="{loc:Loc 'Recent projects'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Projects to remember'}" Description="{loc:Loc 'Pinned projects do not count toward this number.'}">
                <NumericUpDown Value="{Binding RecentProjectsLimit}" Minimum="1" Maximum="50" Increment="1" FormatString="0"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Keep pinned projects when clearing'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding ClearRecentKeepsPinned}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Detect preferred language from recent projects'}" Description="{Binding DetectedLanguageText}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding DetectLanguageFromRecent}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Clear recent projects…'}">
                <Button Content="{loc:Loc 'Clear'}" Command="{Binding ClearRecentProjectsCommand}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsList Header="{loc:Loc 'Manage recent projects'}" ItemsSource="{Binding RecentItems}" IsVisible="{Binding HasRecentItems}">
              <c:SettingsList.ItemTemplate>
                <DataTemplate>
                  <c:SettingsRow Stacked="True">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}" Classes="caption" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding Path}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton Classes="icon small settingsAction" IsChecked="{Binding IsPinned, Mode=OneWay}"
                                      ToolTip.Tip="{loc:Loc 'Pin or unpin'}" AutomationProperties.Name="{loc:Loc 'Pin or unpin'}"
                                      Command="{Binding $parent[ItemsControl].DataContext.TogglePinRecentItemCommand}" CommandParameter="{Binding}">
                          <ui:FASymbolIcon Symbol="Pin"/>
                        </ToggleButton>
                        <Button Classes="icon small settingsAction" ToolTip.Tip="{loc:Loc 'Remove from list'}"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveRecentItemCommand}" CommandParameter="{Binding}">
                          <ui:FASymbolIcon Symbol="Dismiss"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </c:SettingsRow>
                </DataTemplate>
              </c:SettingsList.ItemTemplate>
          </c:SettingsList>
          <c:SettingsGroup Header="{loc:Loc 'Lists'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Keys per page'}">
                <NumericUpDown Value="{Binding PageSize}" Minimum="5" Maximum="500" Increment="5" FormatString="0"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Show at most this many search results'}">
                <NumericUpDown Value="{Binding TruncateSize}" Minimum="100" Maximum="100000" Increment="100" FormatString="0"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Tree loading depth'}" Description="{loc:Loc 'How many namespace levels are built up-front. Deeper levels load when expanded.'}">
                <NumericUpDown Value="{Binding LoadingDepth}" Minimum="1" Maximum="5" FormatString="0"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
        </StackPanel>

        <!-- 1 Appearance -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="1">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Appearance'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Theme'}">
                <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.ThemeOptions}" SelectedItem="{Binding Theme}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Editor font size'}">
                <NumericUpDown Value="{Binding FontSize}" Minimum="11" Maximum="18" FormatString="0"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup Header="{loc:Loc 'Color scheme'}" Footer="{loc:Loc 'Colors preview live. They are kept when you click Save and undone on Cancel.'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Scheme'}">
                <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.SchemeNames}" SelectedItem="{Binding ColorScheme}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Presets'}" Stacked="True">
                <ItemsControl ItemsSource="{x:Static vm:OptionsViewModel.SchemePresets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="swatch" Background="{Binding Swatch}" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectPresetCommand}" CommandParameter="{Binding Name}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Accent color'}" Description="{loc:Loc 'Hex value such as #0097A7.'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="colorChip" Background="{Binding AccentBrush}"/>
                  <TextBox Classes="mono" Classes.invalid="{Binding AccentInvalid}" Width="110" MinWidth="0" MaxLength="9"
                           Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Reset color scheme'}" Description="{loc:Loc 'Back to the Toucan preset with no color edits.'}">
                <Button Content="{loc:Loc 'Reset'}" Command="{Binding ResetColorSchemeCommand}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsList Header="{loc:Loc 'Customize colors'}" ItemsSource="{Binding SchemeColorItems}" MaxListHeight="360"
                          Footer="{loc:Loc 'Edit the colors of one theme at a time. Colors that differ from the default are marked and can be reset.'}">
            <c:SettingsList.Actions>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.VariantOptions}" SelectedItem="{Binding EditingVariant}" MinWidth="90"/>
                <Button Classes="link" Content="{loc:Loc 'Reset colors'}" Command="{Binding ResetSchemeColorsCommand}"/>
              </StackPanel>
            </c:SettingsList.Actions>
            <c:SettingsList.ItemTemplate>
              <DataTemplate>
                <c:SettingsRow Compact="True" Title="{Binding Label}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="colorChip" Background="{Binding Brush}"/>
                    <TextBox Classes="mono" Classes.invalid="{Binding !IsValid}" Width="110" MinWidth="0" MaxLength="9"
                             Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Classes="icon small settingsAction" Command="{Binding ResetCommand}" IsEnabled="{Binding IsOverridden}"
                            ToolTip.Tip="{loc:Loc 'Reset to default'}">
                      <ui:FASymbolIcon Symbol="Undo"/>
                    </Button>
                  </StackPanel>
                </c:SettingsRow>
              </DataTemplate>
            </c:SettingsList.ItemTemplate>
          </c:SettingsList>
        </StackPanel>

        <!-- 2 Editor -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="2">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Editor'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Default language'}" Description="{loc:Loc 'Used as the source language when a project doesn\'t specify one.'}">
                <Button Content="{Binding DefaultLanguageText}" Command="{Binding ChooseDefaultLanguageCommand}" MinWidth="{DynamicResource SettingsControlWidth}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Treat keys as plain text (don\'t split on dots)'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding PlainTextKeys}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsList Header="{loc:Loc 'Copy templates'}" ShowSearch="False" ItemsSource="{Binding CopyTemplates}"
                          AddText="{loc:Loc 'Add template'}" AddCommand="{Binding AddCopyTemplateCommand}" CanAdd="{Binding CanAddCopyTemplate}" Footer="{loc:Loc '“Copy key as” wraps the key in a template. %1 is replaced by the key, e.g. t(\'%1\').'}">
            <c:SettingsList.ItemTemplate>
                  <DataTemplate>
                    <c:SettingsRow Stacked="True">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="icon small settingsAction" Margin="10,0,0,0" ToolTip.Tip="Remove template"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveCopyTemplateCommand}" CommandParameter="{Binding}">
                          <ui:FASymbolIcon Symbol="Dismiss"/>
                        </Button>
                        <TextBox Text="{Binding Value}" Classes="mono"/>
                      </DockPanel>
                    </c:SettingsRow>
                  </DataTemplate>
                </c:SettingsList.ItemTemplate>
          </c:SettingsList>
        </StackPanel>

        <!-- 3 Translation -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="3">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Machine translation'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Translation providers &amp; API keys…'}">
                <Button Content="{loc:Loc 'Configure…'}" Command="{Binding OpenProviderSettingsCommand}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Formality'}">
                <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.FormalityOptions}" SelectedItem="{Binding Formality}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Preserve placeholders ({{name}}, {0}, %s, :param)'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding PreservePlaceholders}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Preview before applying machine translations'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding PreviewBeforeApply}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup Footer="{loc:Loc 'These are defaults for new projects. Each project can override them in Project Properties.'}">
            <c:SettingsRow Title="{loc:Loc 'Application context'}" Stacked="True"
                           Description="{loc:Loc 'Describe your app so AI and translation providers pick the right terminology'}">
              <StackPanel Spacing="4">
                <TextBox Text="{Binding Context}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"/>
                <TextBlock Text="{Binding ContextCharCount, StringFormat='{}{0} characters'}" Classes="hint" HorizontalAlignment="Right"/>
              </StackPanel>
            </c:SettingsRow>
          </c:SettingsGroup>
        </StackPanel>

        <!-- 4 AI -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="4">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'AI'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <Panel IsVisible="{Binding Ai, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel DataContext="{Binding Ai}">
            <c:SettingsGroup Footer="{Binding StatusText}">
              <c:SettingsRow Title="{loc:Loc 'Use AI features'}" Description="{loc:Loc 'One switch for the whole app: AI translation, Analyze, Clarity and any other AI feature.'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding Enabled}"/>
              </c:SettingsRow>
            </c:SettingsGroup>

            <c:SettingsGroup Header="{loc:Loc 'AI service'}" IsEnabled="{Binding Enabled}" Footer="{Binding TestResult}">
              <StackPanel>
                <c:SettingsRow Title="{loc:Loc 'Service'}" Description="{Binding BackendDescription}">
                  <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" MinWidth="{DynamicResource SettingsControlWidth}"/>
                </c:SettingsRow>
                <c:SettingsRow Title="{loc:Loc 'API key'}" Description="{Binding ApiKeyHint}">
                  <TextBox Text="{Binding ApiKey}" PasswordChar="•" Classes="revealPasswordButton mono" MinWidth="{DynamicResource SettingsControlWidth}"
                           AutomationProperties.Name="{loc:Loc 'API key'}"/>
                </c:SettingsRow>
                <c:SettingsRow Title="{loc:Loc 'Model'}" Description="{loc:Loc 'Leave empty to use the default shown.'}">
                  <TextBox Text="{Binding Model}" PlaceholderText="{Binding ModelPlaceholder}" Classes="mono" MinWidth="{DynamicResource SettingsControlWidth}"/>
                </c:SettingsRow>
                <c:SettingsRow Title="{loc:Loc 'Endpoint'}" Description="{loc:Loc 'API base URL. Change it for Azure, a proxy or a local server.'}">
                  <TextBox Text="{Binding Endpoint}" PlaceholderText="{Binding EndpointPlaceholder}" Classes="mono" MinWidth="{DynamicResource SettingsControlWidth}"/>
                </c:SettingsRow>
                <c:SettingsRow Title="{loc:Loc 'Test connection'}" Description="{loc:Loc 'Sends a one-word request with the values above.'}">
                  <Button Content="{loc:Loc 'Test'}" Command="{Binding TestConnectionCommand}"/>
                </c:SettingsRow>
              </StackPanel>
            </c:SettingsGroup>

            <c:SettingsList Header="{loc:Loc 'Features and prompts'}" ItemsSource="{Binding Features}" ShowSearch="False" MaxListHeight="Infinity"
                            IsEnabled="{Binding Enabled}"
                            Footer="{loc:Loc 'Every prompt Toucan sends is open and editable. The defaults are part of Toucan\'s source code; your versions are plain files in Documents/Toucan/prompts, and a project can have its own in .toucan/prompts.'}">
              <c:SettingsList.Actions>
                <Button Classes="link" Content="{loc:Loc 'Show prompt files'}" Command="{Binding OpenPromptsFolderCommand}"/>
              </c:SettingsList.Actions>
              <c:SettingsList.ItemTemplate>
                <DataTemplate>
                  <c:SettingsRow Title="{Binding DisplayName}" Description="{Binding Description}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <Border Classes="badge" IsVisible="{Binding IsCustomized}"><TextBlock Text="{Binding PromptSourceText}"/></Border>
                      <Button Content="{loc:Loc 'Edit prompt…'}" Command="{Binding EditPromptCommand}"/>
                      <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding Enabled}" OnContent="" OffContent=""
                                    AutomationProperties.Name="{Binding DisplayName}"/>
                    </StackPanel>
                  </c:SettingsRow>
                </DataTemplate>
              </c:SettingsList.ItemTemplate>
            </c:SettingsList>
          </StackPanel>
          </Panel>
        </StackPanel>

        <!-- 5 Validation -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="5">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Validation'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <c:SettingsRow Title="{loc:Loc 'Validate before saving (errors block the save)'}">
              <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding ValidateOnSave}"/>
            </c:SettingsRow>
          </c:SettingsGroup>
          <c:SettingsList Header="{loc:Loc 'Rules'}" ItemsSource="{Binding ValidationRules}" MaxListHeight="400">
              <c:SettingsList.ItemTemplate>
                <DataTemplate>
                  <c:SettingsRow Title="{Binding Label}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.SeverityOptions}" SelectedItem="{Binding Severity}"
                                IsEnabled="{Binding Enabled}"/>
                      <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding Enabled}"/>
                    </StackPanel>
                  </c:SettingsRow>
                </DataTemplate>
              </c:SettingsList.ItemTemplate>
          </c:SettingsList>
        </StackPanel>

        <!-- 6 Translation memory -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="6">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Translation memory'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Entries stored'}">
                <TextBlock Text="{Binding TmEntryCount}" Classes="caption"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Suggest matches while editing'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding TmAutoSuggest}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{Binding TmSimilarityThreshold, StringFormat='Minimum similarity: {0:P0}'}">
                <Slider Minimum="0.3" Maximum="1" Value="{Binding TmSimilarityThreshold}" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="200"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Maximum suggestions'}">
                <NumericUpDown Value="{Binding TmMaxSuggestions}" Minimum="1" Maximum="10" FormatString="0"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Scope'}">
                <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.TmScopeOptions}" SelectedIndex="{Binding TmGlobalScopeIndex}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
        </StackPanel>

        <!-- 7 Source code -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="7">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Source code'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Preset'}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.FrameworkPresets}" SelectedItem="{Binding SelectedFrameworkPreset}"/>
                  <Button Content="{loc:Loc 'Apply preset'}" Command="{Binding ApplyFrameworkPresetCommand}"/>
                </StackPanel>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Scan source code when a project opens'}">
                <ToggleSwitch Classes="settingsToggle" IsChecked="{Binding DefaultAutoScanOnOpen}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'File extensions to scan'}" Stacked="True">
                <TextBox Text="{Binding DefaultScanExtensions}" Classes="mono"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Excluded folders'}" Stacked="True">
                <TextBox Text="{Binding DefaultExcludedDirectories}" Classes="mono"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Key pattern (regex, first group = key)'}" Stacked="True">
                <TextBox Text="{Binding DefaultKeyMatcherPattern}" Classes="mono"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'External editor command'}" Stacked="True"
                             Description="{}{file} and {line} are replaced. Examples: code --goto &quot;{file}:{line}&quot;, subl &quot;{file}:{line}&quot;, idea --line {line} &quot;{file}&quot;">
                <TextBox Text="{Binding DefaultExternalEditor}" Classes="mono"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
        </StackPanel>

        <!-- 8 Languages -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="8">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Suggested languages'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsList ItemsSource="{Binding SuggestedLanguageEntries}" EmptyText="{loc:Loc 'No suggested languages'}"
                          AddText="{loc:Loc 'Add language…'}" AddCommand="{Binding AddSuggestedLanguageCommand}" Footer="{loc:Loc 'Offered by “Add suggested languages” when creating a project.'}">
            <c:SettingsList.ItemTemplate>
                  <DataTemplate>
                    <c:SettingsRow Compact="True" Title="{Binding DisplayName}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="langBadge" Margin="0" VerticalAlignment="Center"><TextBlock Text="{Binding Code}"/></Border>
                        <Button Classes="icon small" ToolTip.Tip="{loc:Loc 'Remove'}"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveSuggestedLanguageCommand}" CommandParameter="{Binding}">
                          <ui:FASymbolIcon Symbol="Dismiss"/>
                        </Button>
                      </StackPanel>
                    </c:SettingsRow>
                  </DataTemplate>
                </c:SettingsList.ItemTemplate>
          </c:SettingsList>
        </StackPanel>

        <!-- 9 Shortcuts -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="9">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Keyboard shortcuts'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <ItemsControl ItemsSource="{Binding ShortcutGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <c:SettingsList Header="{Binding Category}" ItemsSource="{Binding Items}" ShowSearch="False" MaxListHeight="Infinity">
                  <c:SettingsList.ItemTemplate>
                    <DataTemplate>
                      <c:SettingsRow Compact="True" Title="{Binding Action}">
                        <Border Classes="badge"><TextBlock Text="{Binding Shortcut}" Classes="mono"/></Border>
                      </c:SettingsRow>
                    </DataTemplate>
                  </c:SettingsList.ItemTemplate>
                </c:SettingsList>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- 10 Integration -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="10">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'System integration'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <c:SettingsGroup Header="{loc:Loc '.tproj file association'}" IsVisible="{Binding CanManageAssociation}" Footer="{Binding AssociationNote}">
            <c:SettingsRow Title="{Binding AssociationStatus}" Description="{loc:Loc 'Open .tproj project files in Toucan by double-clicking them.'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Loc 'Install'}" Command="{Binding InstallAssociationCommand}" IsEnabled="{Binding !AssociationInstalled}"/>
                <Button Content="{loc:Loc 'Remove'}" Command="{Binding RemoveAssociationCommand}" IsEnabled="{Binding AssociationInstalled}"/>
              </StackPanel>
            </c:SettingsRow>
          </c:SettingsGroup>
          <c:SettingsGroup Header="{loc:Loc 'Folder context menu'}" IsVisible="{Binding CanManageFolderEntry}">
            <c:SettingsRow Title="{Binding FolderEntryStatus}" Description="{loc:Loc 'Add “Open with Toucan” to the Explorer right-click menu for folders.'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Loc 'Install'}" Command="{Binding InstallFolderEntryCommand}" IsEnabled="{Binding !FolderEntryInstalled}"/>
                <Button Content="{loc:Loc 'Remove'}" Command="{Binding RemoveFolderEntryCommand}" IsEnabled="{Binding FolderEntryInstalled}"/>
              </StackPanel>
            </c:SettingsRow>
          </c:SettingsGroup>
          <c:SettingsGroup Header="{loc:Loc 'Folders'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Settings folder'}" Description="{Binding SettingsFolder}">
                <Button Content="{loc:Loc 'Open'}" Command="{Binding OpenSettingsFolderCommand}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Plugins folder'}" Description="{Binding PluginsFolder}">
                <Button Content="{loc:Loc 'Open'}" Command="{Binding OpenPluginsFolderCommand}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
        </StackPanel>

        <!-- 11 Data & privacy -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="11">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Data &amp; privacy'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <TextBlock TextWrapping="Wrap" Classes="caption" Margin="0,0,0,16"
                     Text="{loc:Loc 'Settings, layout, prompts and translation memory are stored in Documents/Toucan. API keys are kept in one encrypted secret store in your user profile (DPAPI on Windows, AES with a per-user key elsewhere), never in a project folder. Text is only sent to a translation provider or AI service when you run machine translation or an AI command, and never to an AI service while AI is off.'}"/>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Export settings…'}">
                <Button Content="{loc:Loc 'Export'}" Command="{Binding ExportSettingsCommand}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Import settings…'}">
                <Button Content="{loc:Loc 'Import'}" Command="{Binding ImportSettingsCommand}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsList Header="{loc:Loc 'Stored secrets'}" ItemsSource="{Binding StoredSecrets}" ShowSearch="False"
                          EmptyText="{loc:Loc 'No API keys or tokens are stored.'}"
                          Footer="{loc:Loc 'Names only; values are never shown. ai/… are AI services, mt/… translation providers, project/… a project\'s own provider keys.'}">
            <c:SettingsList.Actions>
              <Button Classes="link" Content="{loc:Loc 'Remove all'}" Command="{Binding RemoveAllSecretsCommand}" IsEnabled="{Binding HasStoredSecrets}"/>
            </c:SettingsList.Actions>
            <c:SettingsList.ItemTemplate>
              <DataTemplate>
                <c:SettingsRow Compact="True" Title="{Binding}">
                  <Button Classes="icon small settingsAction" ToolTip.Tip="{loc:Loc 'Remove'}" AutomationProperties.Name="{loc:Loc 'Remove'}"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveSecretCommand}" CommandParameter="{Binding}">
                    <ui:FASymbolIcon Symbol="Dismiss"/>
                  </Button>
                </c:SettingsRow>
              </DataTemplate>
            </c:SettingsList.ItemTemplate>
          </c:SettingsList>
          <c:SettingsGroup Header="{loc:Loc 'Clear data'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Clear filter history'}">
                <Button Content="{loc:Loc 'Clear'}" Command="{Binding ClearFilterHistoryCommand}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Clear recent projects…'}">
                <Button Content="{loc:Loc 'Clear'}" Command="{Binding ClearRecentProjectsCommand}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Clear translation memory…'}">
                <Button Content="{loc:Loc 'Clear'}" Command="{Binding ClearTranslationMemoryCommand}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup>
            <c:SettingsRow HorizontalContentAlignment="Left">
              <Button Classes="link" Content="{loc:Loc 'Reset all settings…'}" Command="{Binding ResetAllSettingsCommand}"
                      Foreground="{DynamicResource BadBrush}"/>
            </c:SettingsRow>
          </c:SettingsGroup>
        </StackPanel>

        <!-- 12 Plugins -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="12">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{loc:Loc 'Plugins'}" Classes="dialogTitle" Margin="0,0,0,16"/>
          <TextBlock TextWrapping="Wrap" Classes="caption" Margin="0,0,0,16"
                     Text="{loc:Loc 'Plugins add file formats, translation providers and validation rules. A plugin is ordinary code that runs with your permissions, so Toucan only loads plugins you have enabled and trusted, and asks again if their files change.'}"/>
          <Border IsVisible="{Binding PluginsChanged}" Classes="badge" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc 'Changes apply immediately to your settings and take effect after restarting Toucan.'}" TextWrapping="Wrap"/>
          </Border>
          <c:SettingsGroup IsVisible="{Binding HasNoPlugins}">
            <c:SettingsRow Title="{loc:Loc 'No plugins installed. Put a plugin folder (with a plugin.json) in the plugins folder and restart Toucan.'}"/>
          </c:SettingsGroup>
          <ItemsControl ItemsSource="{Binding Plugins}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <c:SettingsGroup>
                  <StackPanel>
                    <!-- Header: name, version, status and the enable switch -->
                    <Grid ColumnDefinitions="*,Auto" Margin="16,16,16,12">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                          <Border Classes="badge"><TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="mono"/></Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Classes="statusDot" Classes.good="{Binding IsGood}" Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"/>
                          <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>
                      <ToggleSwitch Classes="settingsToggle" Grid.Column="1" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanManage}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                    </Grid>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="16,0,16,16" IsVisible="{Binding HasDescription}"/>
                    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" Margin="16,0,16,16"
                               Foreground="{DynamicResource BadBrush}"/>

                    <!-- Details -->
                    <c:SettingsRow Compact="True" Title="{loc:Loc 'Provides'}" IsVisible="{Binding HasProvides}">
                      <TextBlock Text="{Binding ProvidesText}" Classes="mono caption" TextWrapping="Wrap" TextAlignment="Right"/>
                    </c:SettingsRow>
                    <c:SettingsRow Compact="True" Title="{loc:Loc 'Author'}" IsVisible="{Binding HasAuthor}">
                      <TextBlock Text="{Binding Author}" Classes="caption"/>
                    </c:SettingsRow>
                    <c:SettingsRow Compact="True" Title="{loc:Loc 'Signature'}">
                      <TextBlock Text="{Binding SignatureText}" Classes="caption"/>
                    </c:SettingsRow>
                    <c:SettingsRow Compact="True" Title="SHA-256">
                      <TextBlock Text="{Binding ShortHash}" Classes="mono caption"/>
                    </c:SettingsRow>
                    <c:SettingsRow Compact="True" Title="{loc:Loc 'Folder'}">
                      <TextBlock Text="{Binding Folder}" Classes="mono caption" TextTrimming="PathSegmentEllipsis" MaxWidth="320"
                                 ToolTip.Tip="{Binding Folder}"/>
                    </c:SettingsRow>

                    <!-- Actions -->
                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc 'Show folder'}" Command="{Binding OpenFolderCommand}"/>
                        <Button Content="{loc:Loc 'Revoke trust'}" Command="{Binding RevokeCommand}" IsVisible="{Binding CanRevoke}"/>
                        <Button Content="{loc:Loc 'Trust…'}" Classes="accent" Command="{Binding TrustCommand}" IsVisible="{Binding CanTrust}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </c:SettingsGroup>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Built-in modules: compiled in and always on, so one compact list of name and version -->
          <c:SettingsList Header="{loc:Loc 'Built-in modules'}" ItemsSource="{Binding BuiltInModules}" IsVisible="{Binding HasBuiltInModules}"
                          ShowSearch="False" MaxListHeight="Infinity" Margin="0,8,0,24"
                          Footer="{loc:Loc 'Always on. These ship with Toucan as separate assemblies and register the same way plugins do.'}">
            <c:SettingsList.ItemTemplate>
              <DataTemplate>
                <c:SettingsRow Compact="True" Title="{Binding Name}" Description="{Binding Description}" ToolTip.Tip="{Binding Tooltip}">
                  <Border Classes="badge" IsVisible="{Binding HasVersion}"><TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="mono"/></Border>
                </c:SettingsRow>
              </DataTemplate>
            </c:SettingsList.ItemTemplate>
          </c:SettingsList>
        </StackPanel>

        <!-- 13 About -->
        <StackPanel>
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static conv:SettingsPageVisibleConverter.Instance}" ConverterParameter="13">
              <Binding Path="SelectedPageIndex"/>
              <Binding Path="IsSearching"/>
              <Binding Path="SearchMatches"/>
            </MultiBinding>
          </StackPanel.IsVisible>
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,20">
            <Image Source="/Assets/logo.png" Width="64" Height="64"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding VersionText}" Classes="dialogTitle"/>
              <TextBlock Text="{Binding RuntimeText}" Classes="caption"/>
            </StackPanel>
          </StackPanel>
          <c:SettingsGroup Header="{loc:Loc 'Updates'}" Footer="{loc:Loc 'Checking contacts github.com. No project data is sent, and nothing is downloaded or installed automatically.'}">
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'Release channel'}" Description="{loc:Loc 'Preview includes pre-releases.'}">
                <ComboBox ItemsSource="{x:Static vm:OptionsViewModel.UpdateChannelOptions}" SelectedItem="{Binding UpdateChannel}"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{Binding VersionText}" Description="{Binding UpdateStatus}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{loc:Loc 'View release'}" Classes="accent" Command="{Binding OpenUpdateCommand}" IsVisible="{Binding HasUpdate}"/>
                  <Button Content="{loc:Loc 'Check for updates'}" Command="{Binding CheckForUpdatesCommand}"/>
                </StackPanel>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
          <c:SettingsGroup>
            <StackPanel>
              <c:SettingsRow Title="{loc:Loc 'A cross-platform editor for translation files. Built with Avalonia and .NET.'}"
                             Description="{loc:Loc 'MIT License · Copyright © Rasyidf 2023-2026'}"/>
              <c:SettingsRow Title="{loc:Loc 'Website'}">
                <Button Classes="link" Content="toucan.rasyid.dev" Command="{Binding OpenUrlCommand}" CommandParameter="https://toucan.rasyid.dev"/>
              </c:SettingsRow>
              <c:SettingsRow Title="GitHub">
                <Button Classes="link" Content="rasyidf/Toucan" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/rasyidf/Toucan"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Releases'}">
                <Button Classes="link" Content="{loc:Loc 'View releases'}" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/rasyidf/Toucan/releases"/>
              </c:SettingsRow>
              <c:SettingsRow Title="{loc:Loc 'Copy version info'}">
                <Button Classes="link" Content="{loc:Loc 'Copy'}" Command="{Binding CopyVersionCommand}"/>
              </c:SettingsRow>
            </StackPanel>
          </c:SettingsGroup>
        </StackPanel>
      </StackPanel>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</d:DialogWindow>
