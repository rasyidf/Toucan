<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.ImportProjectDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:c="using:Toucan.Avalonia.Views.Components"
                Title="{loc:Loc 'Import Project'}" Width="640" Height="560">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc 'Cancel'}" x:Name="CancelButton"/>
        <Button Content="{loc:Loc 'Import'}" Classes="accent" x:Name="OkButton" IsDefault="True" IsEnabled="{Binding IsValid}"/>
      </StackPanel>
    </Border>
    <DockPanel Margin="20,18,20,12">
      <StackPanel DockPanel.Dock="Top" Spacing="4">
        <TextBlock Text="{loc:Loc 'Import existing project'}" Classes="dialogTitle"/>
        <TextBlock Text="{loc:Loc 'Point Toucan at your app\'s repository or locale folder. It detects the i18n framework and language files.'}" Classes="caption" TextWrapping="Wrap"/>
        <c:SettingsGroup Margin="0,12,0,8" Footer="{Binding DetectionSummary}">
          <StackPanel>
            <c:SettingsRow Title="{loc:Loc 'Folder'}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding Folder}" PlaceholderText="/path/to/your/app" Width="300"/>
                <Button Content="{loc:Loc 'Browse…'}" Command="{Binding BrowseFolderCommand}"/>
              </StackPanel>
            </c:SettingsRow>
            <c:SettingsRow Title="{loc:Loc 'Framework'}">
              <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberBinding="{Binding DisplayName}" MinWidth="220"/>
            </c:SettingsRow>
          </StackPanel>
        </c:SettingsGroup>
        <ItemsControl ItemsSource="{Binding DetectedLanguages}" Margin="0,6,0,6">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="langBadge" Margin="0,0,6,6"><TextBlock Text="{Binding}"/></Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{loc:Loc 'Files'}" Classes="groupHeader" Margin="14,8,0,6"/>
      </StackPanel>
      <Border Classes="card" Padding="2">
        <ListBox Classes="plain" ItemsSource="{Binding DiscoveredFiles}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="badge"><TextBlock Text="{Binding Language}"/></Border>
                <TextBlock Text="{Binding RelativePath}" Classes="mono" FontSize="12" TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>
  </DockPanel>
</d:DialogWindow>
