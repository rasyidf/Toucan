<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.LanguagePromptDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                Width="480" Height="560">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <TextBlock Text="{Binding Result, StringFormat='Selected: {0}'}" Classes="caption" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc 'Cancel'}" x:Name="CancelButton"/>
          <Button Content="{loc:Loc 'Add'}" Classes="accent" x:Name="OkButton" IsDefault="True" IsEnabled="{Binding CanAccept}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,8" Spacing="8">
      <TextBlock Text="{Binding Title}" Classes="dialogTitle"/>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="caption" FontSize="13"/>
      <TextBox x:Name="Filter" Text="{Binding FilterText}" PlaceholderText="{loc:Loc 'Search by name or code (e.g. French, fr-CA)'}" Classes="clearButton">
        <TextBox.InnerLeftContent>
          <ui:FASymbolIcon Symbol="Find" FontSize="14" Margin="8,0,2,0"/>
        </TextBox.InnerLeftContent>
      </TextBox>
    </StackPanel>
    <Border Classes="card" Margin="20,0,20,16" Padding="2">
      <ListBox x:Name="List" Classes="plain" ItemsSource="{Binding FilteredCultures}" SelectedItem="{Binding SelectedLanguage}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding Language}"/>
                <TextBlock Text="{Binding Culture.NativeName}" Classes="caption"/>
              </StackPanel>
              <Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding Culture.Name}" Classes="mono"/></Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</d:DialogWindow>
