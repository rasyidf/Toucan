<d:DialogWindow x:Class="Toucan.Avalonia.Views.Dialogs.PreTranslateDialog"
                xmlns="https://github.com/avaloniaui"
             xmlns:loc="using:Toucan.Avalonia.Locales"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="using:Toucan.Avalonia.Views.Dialogs"
                xmlns:vm="using:Toucan.Avalonia.ViewModels"
                xmlns:ui="using:FluentAvalonia.UI.Controls"
                Title="{loc:Loc 'Pre-translate'}" Width="900" Height="640" MinHeight="460">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc 'Cancel'}" Command="{Binding CancelCommand}"/>
          <Button Content="{loc:Loc 'Apply translations'}" Classes="accent" Command="{Binding CommitCommand}" IsEnabled="{Binding HasPreview}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,8" Spacing="6">
      <TextBlock Text="{loc:Loc 'Pre-translate'}" Classes="dialogTitle"/>
      <TextBlock Text="{loc:Loc 'Runs as a preview first. Nothing changes until you apply.'}" Classes="caption"/>
      <Grid ColumnDefinitions="Auto,12,*" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="{loc:Loc 'Provider'}" Classes="label"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ComboBox ItemsSource="{Binding ProviderNames}" SelectedItem="{Binding SelectedProvider}" MinWidth="170"/>
            <Button Classes="icon" ToolTip.Tip="{loc:Loc 'Provider settings &amp; API keys'}" Command="{Binding OpenProviderSettingsCommand}">
              <ui:FASymbolIcon Symbol="Setting"/>
            </Button>
          </StackPanel>
          <CheckBox Classes="form" Content="{loc:Loc 'Overwrite existing values'}" IsChecked="{Binding OverwriteExisting}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" Content="{loc:Loc 'Toggle all'}" Command="{Binding SelectAllLanguagesCommand}"/>
            <TextBlock Text="{loc:Loc 'Target languages'}" Classes="label"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding AvailableLanguages}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" MinWidth="90" Margin="0,0,8,0"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
        <Button Content="{loc:Loc 'Run preview'}" Classes="accent" Command="{Binding StartCommand}"/>
        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Width="260" VerticalAlignment="Center" IsVisible="{Binding IsRunning}"/>
        <TextBlock VerticalAlignment="Center" Classes="caption" IsVisible="{Binding IsRunning}">
          <Run Text="{Binding ProgressCompleted}"/><Run Text=" / "/><Run Text="{Binding ProgressTotal}"/>
        </TextBlock>
      </StackPanel>
    </StackPanel>

    <Border Classes="card" Margin="20,4,20,16" Padding="0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,70,3*,3*" Margin="12,8">
          <TextBlock Text="{loc:Loc 'Key'}" Classes="caption" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="{loc:Loc 'Lang'}" Classes="caption" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="{loc:Loc 'Source'}" Classes="caption" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="3" Text="{loc:Loc 'Translation'}" Classes="caption" FontWeight="SemiBold"/>
        </Grid>
        <ListBox Classes="plain" ItemsSource="{Binding PreviewResults}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="2*,70,3*,3*">
                <TextBlock Text="{Binding Namespace}" Classes="mono" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Namespace}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Language}" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="{Binding SourceText}" FontSize="12" TextWrapping="Wrap" Classes="caption" Margin="0,0,8,0"/>
                <Panel Grid.Column="3">
                  <TextBlock Text="{Binding TranslatedValue}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Succeeded}"/>
                  <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" IsVisible="{Binding !Succeeded}"/>
                </Panel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</d:DialogWindow>
