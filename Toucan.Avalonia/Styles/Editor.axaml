<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:c="using:Toucan.Avalonia.Views.Components"
        xmlns:views="using:Toucan.Avalonia.Views"
        xmlns:loc="using:Toucan.Avalonia.Locales"
        xmlns:conv="using:Toucan.Avalonia.Converters">

  <Style Selector="c|TranslationCard Panel.valueCell">
    <Setter Property="Grid.Column" Value="1"/>
  </Style>
  <Style Selector="c|TranslationCard Border.rowLanguage">
    <Setter Property="Margin" Value="0,7,10,0"/>
  </Style>
  <Style Selector="c|TranslationCard StackPanel.valueActions">
    <Setter Property="Margin" Value="6,4,0,0"/>
  </Style>
  <Style Selector="c|TranslationCard.narrow Grid.translationRow Panel.valueCell">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="3"/>
  </Style>
  <Style Selector="c|TranslationCard.narrow Border.rowLanguage">
    <Setter Property="Margin" Value="0,0,10,6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|TranslationCard.narrow StackPanel.valueActions">
    <Setter Property="Margin" Value="6,0,0,6"/>
  </Style>

  <!-- Keep selection visible while the caret is inside a field. -->
  <Style Selector="ListBox.editor">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Border.cardFrame">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>
  <Style Selector="c|TranslationCard:pointerover Border.cardFrame">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem:selected Border.cardFrame, c|TranslationCard:focus-within Border.cardFrame">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
  </Style>
  <Style Selector="Grid.translationRow:pointerover Border.rowLanguage, Grid.translationRow:focus-within Border.rowLanguage">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
  </Style>
  <Style Selector="Grid.translationRow:focus-within Border.rowLanguage > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>
  <Style Selector="Border.rowLanguage">
    <Setter Property="Cursor" Value="Ibeam"/>
  </Style>
  <Style Selector="Grid.translationRow">
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- Hover-only row actions in the editor -->
  <Style Selector="Grid.translationRow Button.hoverOnly">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="Grid.translationRow:pointerover Button.hoverOnly, Grid.translationRow:focus-within Button.hoverOnly">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="TextBox.translation">
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MaxHeight" Value="220"/>
    <Setter Property="FontSize" Value="{DynamicResource EditorFontSize}"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TextBox.translation.empty">
    <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
  </Style>
  <Style Selector="TextBox.translation:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="TextBox.translation:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>
  <Style Selector="Grid.rowMeta">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="1"/>
  </Style>
  <Style Selector="c|TranslationCard.narrow Grid.rowMeta">
    <Setter Property="Grid.Row" Value="2"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="3"/>
  </Style>

  <Style Selector="TextBox.translation.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}"/>
  </Style>

  <!-- Pagination -->
  <Style Selector="c|TranslationCard Grid.cardHeader">
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="Grid.ColumnSpan" Value="2"/>
  </Style>
  <Style Selector="c|TranslationCard StackPanel.keyActions">
    <Setter Property="Grid.Column" Value="2"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
  </Style>
  <Style Selector="c|TranslationCard ItemsControl.translationValues, c|TranslationCard ItemsControl.pluralValues">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.ColumnSpan" Value="2"/>
  </Style>
  <Style Selector="Button.editorLayoutPicker">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.editor.rows">
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="ListBox.editor.rows ListBoxItem">
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="ListBox.editor.rows Border.cardFrame">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns Grid.cardHeader">
    <Setter Property="Grid.ColumnSpan" Value="1"/>
    <Setter Property="Margin" Value="0,4,12,0"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns Grid.cardHeader > StackPanel">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="1"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns ItemsControl.translationValues, ListBox.editor.rows c|TranslationCard.columns ItemsControl.pluralValues">
    <Setter Property="Grid.Row" Value="0"/>
    <Setter Property="Grid.Column" Value="1"/>
    <Setter Property="Grid.ColumnSpan" Value="1"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns ItemsControl.translationValues">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns Grid.translationRow">
    <Setter Property="Margin" Value="4,0"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns Border.rowLanguage">
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns Panel.valueCell">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="3"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns StackPanel.valueActions">
    <Setter Property="Margin" Value="6,0,0,5"/>
  </Style>
  <Style Selector="ListBox.editor.rows c|TranslationCard.columns Grid.rowMeta">
    <Setter Property="Grid.Row" Value="2"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="3"/>
  </Style>

  <Style Selector="Button.page, Button.pager, ToggleButton.pager">
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.pager, ToggleButton.pager">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.pager ui|FASymbolIcon, ToggleButton.pager ui|FASymbolIcon">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Button.page.current">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="c|TranslationCard.comparison Grid.translationRow">
    <Setter Property="Margin" Value="0,4,8,4"/>
  </Style>
</Styles>
