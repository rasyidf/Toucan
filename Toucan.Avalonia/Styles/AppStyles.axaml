<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:c="using:Toucan.Avalonia.Views.Components"
        xmlns:views="using:Toucan.Avalonia.Views"
        xmlns:loc="using:Toucan.Avalonia.Locales"
        xmlns:conv="using:Toucan.Avalonia.Converters">

  <!-- ═══ Text ═══ -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    <Setter Property="Margin" Value="0,12,0,6"/>
  </Style>
  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.dialogTitle">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Menlo, Consolas, 'Cascadia Mono', 'DejaVu Sans Mono', monospace"/>
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Menlo, Consolas, 'Cascadia Mono', 'DejaVu Sans Mono', monospace"/>
  </Style>

  <!-- ═══ Icon buttons: expose the tooltip as the accessible name for screen readers ═══ -->
  <Style Selector="Button.icon, ToggleButton.icon, Button.activity">
    <Setter Property="AutomationProperties.Name" Value="{Binding $self.(ToolTip.Tip)}"/>
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.icon ui|FASymbolIcon">
    <Setter Property="FontSize" Value="16"/>
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="4"/>
  </Style>
  <Style Selector="Button.small ui|FASymbolIcon">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="ToggleButton.icon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="ToggleButton.icon ui|FASymbolIcon">
    <Setter Property="FontSize" Value="16"/>
  </Style>
  <Style Selector="ToggleButton.small">
    <Setter Property="Padding" Value="4"/>
  </Style>
  <Style Selector="ToggleButton.small ui|FASymbolIcon">
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- Flat text buttons (links in the start screen, inspector actions) -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!-- Small on/off chips inside a text box (match case, whole word, regex) -->
  <Style Selector="ToggleButton.option">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.option:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.option.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>
  <Style Selector="Button.row.match">
    <Setter Property="Padding" Value="22,3,6,3"/>
  </Style>
  <Style Selector="Button.row.match.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
  </Style>

  <!-- Borderless button used as a clickable row -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>

  <!-- ═══ Activity bar ═══ -->
  <Style Selector="Button.activity">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,3"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="ToolTip.Placement" Value="Right"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="c|ActivityBar.rightRail Button.activity">
    <Setter Property="ToolTip.Placement" Value="Left"/>
  </Style>
  <Style Selector="Button.activity ui|FASymbolIcon">
    <Setter Property="FontSize" Value="20"/>
  </Style>
  <Style Selector="Button.activity:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="Button.activity.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.activity.active ui|FASymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
  </Style>

  <!-- Segmented mode selector -->
  <Style Selector="Button.segment">
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="MinWidth" Value="76"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button.segment.active">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- App-wide workspace modes in the title bar. -->
  <Style Selector="Button.modeTab">
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
          <!-- Not named PART_ContentPresenter: the Fluent theme paints that name on hover, which drew a second, lighter box inside the tab. -->
          <ContentPresenter x:Name="TabContent" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.modeTab:pointerover, Button.modeTab:focus-visible">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
  </Style>
  <Style Selector="Button.modeTab.active">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>

  <!-- ═══ Surfaces ═══ -->
  <Style Selector="Border.shellSurface">
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <!-- Same height as the editor's filter toolbar (5 + 32 filter box + 6 padding + 1 border) so the divider lines up across the three columns. -->
  <Style Selector="Border.panelHeader">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="10,0,4,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Padding" Value="10,5,10,6"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style Selector="Border.langBadge">
    <Setter Property="Background" Value="{DynamicResource BadgeBackgroundBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <Style Selector="Border.langBadge > TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Border.langBadge.primary">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
  </Style>

  <!-- ═══ Status bar ═══ -->
  <Style Selector="Button.status">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource StatusBarForegroundBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.status:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource StatusBarForegroundBrush}"/>
  </Style>
  <Style Selector="Button.status ui|FASymbolIcon">
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="Foreground" Value="{DynamicResource StatusBarForegroundBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,0"/>
  </Style>

  <!-- ═══ Lists ═══ -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Margin" Value="2,1"/>
  </Style>

  <!-- Editor cards: selection shown as an accent bar instead of a filled highlight -->
  <Style Selector="ListBox.editor">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.editor ListBoxItem:selected Border.cardFrame">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>

  <Style Selector="Border.cardFrame">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>

  <!-- Hover-only row actions in the editor -->
  <Style Selector="Grid.translationRow Button.hoverOnly">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="Grid.translationRow:pointerover Button.hoverOnly, Grid.translationRow:focus-within Button.hoverOnly">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector="TextBox.translation">
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MaxHeight" Value="220"/>
    <Setter Property="FontSize" Value="{DynamicResource EditorFontSize}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.translation.empty">
    <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
  </Style>

  <!-- Pagination -->
  <Style Selector="Button.page, Button.pager, ToggleButton.pager">
    <Setter Property="MinWidth" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.pager, ToggleButton.pager">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.pager ui|FASymbolIcon, ToggleButton.pager ui|FASymbolIcon">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Button.page.current">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
  </Style>

  <!-- Dialog footer -->
  <Style Selector="Border.dialogFooter">
    <Setter Property="Padding" Value="20,12"/>
    <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="Border.dialogFooter Button">
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
  </Style>

  <!-- Form rows -->
  <Style Selector="TextBlock.label">
    <Setter Property="Margin" Value="0,10,0,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Margin" Value="0,3,0,0"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}"/>
  </Style>
  <Style Selector="CheckBox.form">
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <!-- ═══ Settings (grouped list) ═══ -->
  <Style Selector="c|SettingsGroup">
    <Setter Property="CornerRadius" Value="{DynamicResource SettingsCardRadius}"/>
    <Setter Property="Margin" Value="{DynamicResource SettingsCardMargin}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel IsVisible="{TemplateBinding IsMatch}">
          <Grid x:Name="GroupHeaderRow" MinHeight="{DynamicResource SettingsHeaderHeight}" Margin="0,0,0,6"
                IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock x:Name="GroupHeader" Text="{TemplateBinding Header}" Classes="groupHeader" VerticalAlignment="Center"/>
          </Grid>
          <Border Background="{DynamicResource SettingsCardBackgroundBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                  BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          <TextBlock x:Name="GroupFooter" Text="{TemplateBinding Footer}" FontSize="12" TextWrapping="Wrap" Margin="{DynamicResource SettingsFooterMargin}"
                     Foreground="{DynamicResource SettingsFooterForegroundBrush}"
                     IsVisible="{TemplateBinding Footer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBlock.groupHeader">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsHeaderForegroundBrush}"/>
    <Setter Property="Margin" Value="{DynamicResource SettingsHeaderMargin}"/>
  </Style>
  <Style Selector="TextBlock.groupFooter">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsFooterForegroundBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="{DynamicResource SettingsFooterMargin}"/>
  </Style>
  <Style Selector="c|SettingsRow">
    <Setter Property="Padding" Value="{DynamicResource SettingsRowPadding}"/>
    <Setter Property="MinRowHeight" Value="{DynamicResource SettingsRowMinHeight}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsDividerBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                IsVisible="{TemplateBinding IsMatch}"
                Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinRowHeight}">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
            <StackPanel x:Name="RowLabels" Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0"
                        IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{TemplateBinding Title}" TextWrapping="Wrap"/>
              <TextBlock Text="{TemplateBinding Description}" Classes="hint" Margin="0" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              HorizontalContentAlignment="Stretch"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|SettingsRow:compact">
    <Setter Property="Padding" Value="{DynamicResource SettingsRowCompactPadding}"/>
    <Setter Property="MinRowHeight" Value="{DynamicResource SettingsRowCompactMinHeight}"/>
  </Style>
  <Style Selector="c|SettingsRow:not(:stacked) ComboBox, c|SettingsRow:not(:stacked) NumericUpDown, c|SettingsRow:not(:stacked) TextBox:not(.mono)">
    <Setter Property="Width" Value="{DynamicResource SettingsControlWidth}"/>
  </Style>
  <Style Selector="c|SettingsRow:nth-child(n+2)">
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="ItemsControl.rows ContentPresenter:nth-child(n+2) > c|SettingsRow">
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="c|SettingsRow:stacked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="c|SettingsRow:stacked /template/ StackPanel#RowLabels">
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="c|SettingsRow ComboBox, c|SettingsRow TextBox, c|SettingsRow NumericUpDown">
    <Setter Property="MinWidth" Value="160"/>
  </Style>
  <Style Selector="c|SettingsRow:stacked TextBox, c|SettingsRow:stacked ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="c|SettingsRow ToggleSwitch">
    <Setter Property="OnContent" Value=""/>
    <Setter Property="OffContent" Value=""/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|SettingsRow StackPanel">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|SettingsRow ComboBox, c|SettingsRow NumericUpDown, c|SettingsRow Button, c|SettingsRow TextBox">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Settings list: card with count, filter box, capped scroll area, empty state and add row -->
  <Style Selector="c|SettingsList">
    <Setter Property="Margin" Value="{DynamicResource SettingsCardMargin}"/>
    <Setter Property="MaxListHeight" Value="{DynamicResource SettingsListMaxHeight}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel IsVisible="{TemplateBinding IsMatch}">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6" MinHeight="{DynamicResource SettingsHeaderHeight}"
                IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock x:Name="GroupHeader" Text="{TemplateBinding Header}" Classes="groupHeader" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="badge" Margin="8,0,0,0"
                    IsVisible="{TemplateBinding CountText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{TemplateBinding CountText}"/>
            </Border>
            <ContentPresenter Grid.Column="2" Margin="8,0,0,0" Content="{TemplateBinding Actions}" VerticalAlignment="Center"/>
          </Grid>
          <Border Background="{DynamicResource SettingsCardBackgroundBrush}" BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource SettingsCardRadius}" ClipToBounds="True">
            <StackPanel>
              <Border Classes="settingsListToolbar" IsVisible="{TemplateBinding IsSearchBarVisible}">
                <TextBox x:Name="PART_SearchBox" Classes="clearButton" Text="{TemplateBinding SearchText, Mode=TwoWay}"
                         PlaceholderText="{loc:Loc 'Filter list…'}" MinWidth="0">
                  <TextBox.InnerLeftContent>
                    <ui:FASymbolIcon Symbol="Find" FontSize="12" Margin="10,0,0,0" Foreground="{DynamicResource FaintTextBrush}"/>
                  </TextBox.InnerLeftContent>
                </TextBox>
              </Border>
              <ScrollViewer MaxHeight="{TemplateBinding MaxListHeight}" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" IsVisible="{TemplateBinding ItemCount, Converter={x:Static conv:SettingsListConverters.HasItems}}">
                <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </ScrollViewer>
              <TextBlock Text="{TemplateBinding EmptyMessage}" Classes="caption" TextAlignment="Center" TextWrapping="Wrap" Margin="14,16"
                         IsVisible="{TemplateBinding EmptyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Border BorderBrush="{DynamicResource SettingsDividerBrush}" BorderThickness="0,1,0,0" Padding="14,6"
                      IsVisible="{TemplateBinding AddCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Button Classes="link" HorizontalAlignment="Left" Content="{TemplateBinding AddText}"
                        Command="{TemplateBinding AddCommand}" IsEnabled="{TemplateBinding CanAdd}"/>
              </Border>
            </StackPanel>
          </Border>
          <TextBlock Text="{TemplateBinding Footer}" FontSize="12" TextWrapping="Wrap" Margin="{DynamicResource SettingsFooterMargin}"
                     Foreground="{DynamicResource SettingsFooterForegroundBrush}"
                     IsVisible="{TemplateBinding Footer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
  </Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>
  <Style Selector="Border.colorChip">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorderBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}"/>
  </Style>
  <Style Selector="Border.settingsListToolbar">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource SettingsToolbarBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsDividerBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="c|SettingsList ContentPresenter:nth-child(n+2) > c|SettingsRow">
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="c|SettingsList ContentPresenter.firstVisible > c|SettingsRow">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="c|SettingsList c|SettingsRow:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource SettingsRowHoverBrush}"/>
  </Style>
  <Style Selector="c|SettingsList.compact">
    <Setter Property="MaxListHeight" Value="200"/>
  </Style>

  <!-- Settings sidebar (rounded colored icon tiles, selection pill) -->
  <Style Selector="ListBox.settingsNav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,0"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem /template/ Rectangle#SelectionIndicator">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
  </Style>
  <Style Selector="Border.navTile">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style Selector="Border.navTile ui|FASymbolIcon">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- Tabs: the Fluent default header font is far too large for a dialog -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="12,4"/>
  </Style>

  <!-- Inputs: center the text vertically (Fluent's default sits high on macOS) -->
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="10,7,6,7"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="10,9,0,5"/>
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="Padding" Value="10,7,6,7"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- Status dot (plugins) -->
  <Style Selector="Ellipse.statusDot">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="Fill" Value="{DynamicResource FaintTextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Ellipse.statusDot.good"><Setter Property="Fill" Value="{DynamicResource GoodBrush}"/></Style>
  <Style Selector="Ellipse.statusDot.warn"><Setter Property="Fill" Value="{DynamicResource WarnBrush}"/></Style>
  <Style Selector="Ellipse.statusDot.bad"><Setter Property="Fill" Value="{DynamicResource BadBrush}"/></Style>

  <!-- Toggle used as a disclosure header: no accent fill when checked -->
  <Style Selector="ToggleButton.row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ToggleButton.row:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.row:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="ToggleButton.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
  </Style>

  <!-- Framework tiles (New project) -->
  <Style Selector="Border.fwTile">
    <Setter Property="Width" Value="164"/>
    <Setter Property="Height" Value="64"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
  </Style>
  <Style Selector="ListBoxItem:selected Border.fwTile">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
  </Style>
  <Style Selector="ListBoxItem /template/ Rectangle#SelectionIndicator">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Border.fwBadge">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style Selector="Border.fwBadge > TextBlock">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.statTile">
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>

  <!-- Rows inside a card that is built from an ItemsControl (inspector lists) -->
  <Style Selector="Border.itemRow">
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
  </Style>
  <Style Selector="ItemsControl.rows ContentPresenter:nth-child(n+2) > Border.itemRow">
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="Button.inspectorAction">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>

  <!-- Side panels: compact type and controls, one 10px inset -->
  <Style Selector="ContentControl.panelHost Button:not(.icon):not(.row):not(.link):not(.statRow):not(.segment):not(.modeTab):not(.page):not(.pager)">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ContentControl.panelHost TextBlock.caption">
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style Selector="c|SettingsGroup.compact /template/ Grid#GroupHeaderRow">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="c|SettingsGroup.compact /template/ TextBlock#GroupHeader">
    <Setter Property="Margin" Value="4,0,0,4"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style Selector="Button.providerRow">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="Button.providerRow.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
  </Style>

  <!-- Editor toolbar: uniform 28px icon buttons, soft checked state, rounded filter box -->
  <Style Selector="Border.toolbar Button.icon, Border.toolbar ToggleButton.icon">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.toolbar Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Border.toolbar ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
  </Style>
  <Style Selector="Border.toolbar ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter, Border.toolbar ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="Border.toolbar TextBox">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Rectangle.toolbarSeparator">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Margin" Value="6,0"/>
    <Setter Property="Fill" Value="{DynamicResource SubtleBorderBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Bulk-action bar buttons -->
  <Style Selector="Button.bulk">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
  </Style>
  <Style Selector="Button.bulk.accent">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.bulk:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
  </Style>

  <!-- Command palette -->
  <Style Selector="TextBox.paletteInput">
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="TextBox.paletteInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.paletteList ListBoxItem">
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Grid.disabled">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>

  <!-- Title bar: command palette pill and save-state chip -->
  <Style Selector="Button.palettePill">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="Button.palettePill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="Button.saveState">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
  </Style>
  <Style Selector="Button.saveState.dirty">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  </Style>
  <!-- Saved: nothing to click, so keep it looking normal rather than disabled -->
  <Style Selector="Button.saveState:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.saveState:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
  </Style>
  <Style Selector="c|SettingsGroup.compact">
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="c|SettingsGroup.compact /template/ TextBlock#GroupFooter">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="10,6,10,0"/>
  </Style>
  <Style Selector="c|TranslationCard Button.icon, c|TranslationCard ToggleButton.icon">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="4"/>
  </Style>
  <Style Selector="c|TranslationCard Panel.valueCell">
    <Setter Property="Grid.Column" Value="1"/>
  </Style>
  <Style Selector="c|TranslationCard Border.rowLanguage">
    <Setter Property="Margin" Value="0,7,10,0"/>
  </Style>
  <Style Selector="c|TranslationCard StackPanel.valueActions">
    <Setter Property="Margin" Value="6,4,0,0"/>
  </Style>
  <Style Selector="views|TranslationEditorView StackPanel.filterActions">
    <Setter Property="Grid.Column" Value="1"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
  </Style>
  <Style Selector="c|TranslationCard.narrow Grid.translationRow Panel.valueCell">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="3"/>
  </Style>
  <Style Selector="c|TranslationCard.narrow Border.rowLanguage">
    <Setter Property="Margin" Value="0,0,10,6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="c|TranslationCard.narrow StackPanel.valueActions">
    <Setter Property="Margin" Value="6,0,0,6"/>
  </Style>
  <Style Selector="Button.settingsAction, ToggleButton.settingsAction">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="views|TranslationEditorView.narrow TextBox.filterInput">
    <Setter Property="Grid.ColumnSpan" Value="2"/>
  </Style>
  <Style Selector="views|TranslationEditorView.narrow StackPanel.filterActions">
    <Setter Property="Grid.Row" Value="1"/>
    <Setter Property="Grid.Column" Value="0"/>
    <Setter Property="Grid.ColumnSpan" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <Style Selector="ToggleSwitch.settingsToggle">
    <Style.Resources>
      <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
      <GridLength x:Key="ToggleSwitchPreContentMargin">2</GridLength>
      <GridLength x:Key="ToggleSwitchPostContentMargin">2</GridLength>
    </Style.Resources>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="Menlo, Consolas, 'Cascadia Mono', 'DejaVu Sans Mono', monospace"/>
  </Style>
</Styles>
