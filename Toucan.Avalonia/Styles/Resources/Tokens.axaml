<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Double x:Key="EditorFontSize">13</x:Double>
  <!-- Settings layout tokens (cards, lists, dialog pages) -->
  <CornerRadius x:Key="SettingsCardRadius">8</CornerRadius>
  <Thickness x:Key="SettingsRowPadding">16,10</Thickness>
  <Thickness x:Key="SettingsRowCompactPadding">16,6</Thickness>
  <Thickness x:Key="SettingsHeaderMargin">16,0,0,0</Thickness>
  <Thickness x:Key="SettingsFooterMargin">16,8,16,0</Thickness>
  <Thickness x:Key="SettingsCardMargin">0,0,0,24</Thickness>
  <x:Double x:Key="SettingsRowMinHeight">48</x:Double>
  <x:Double x:Key="SettingsRowCompactMinHeight">40</x:Double>
  <x:Double x:Key="SettingsHeaderHeight">24</x:Double>
  <x:Double x:Key="SettingsControlWidth">200</x:Double>
  <x:Double x:Key="SettingsListMaxHeight">320</x:Double>
  <x:Double x:Key="SettingsPageMaxWidth">600</x:Double>
</ResourceDictionary>
