<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build\.obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ponytail: auto-remove stale default obj/ that conflicts with redirected BaseIntermediateOutputPath -->
  <Target Name="_CleanStaleDefaultObj" BeforeTargets="CoreCompile" Condition="Exists('$(MSBuildProjectDirectory)\obj')">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj" />
  </Target>
</Project>
