<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A connector in miniature: a connection form, per-connection sessions, and Pull and Push commands that change the
    project through the workspace API. The "server" is in memory so the sample runs anywhere. It references only the
    plugin contract, so it has no UI and loads in the CLI too. The working version lives in the toucan-plugins repository.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Toucan.Sample.Connector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Toucan.Plugins.Abstractions\Toucan.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
