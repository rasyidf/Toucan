<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A connector in miniature: one content-source adapter (plugin API 1.3) over an in-memory "service", so the sample runs
    anywhere. Toucan provides accounts, mapping, pull, push, conflicts and the Sources panel; the adapter only moves data.
    It references only the plugin contract, so it has no UI and loads in the CLI too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Toucan.Sample.Connector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Toucan.Plugins.Abstractions\Toucan.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
