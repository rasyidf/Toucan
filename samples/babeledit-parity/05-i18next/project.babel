<?xml version='1.0' encoding='utf-8'?>
<babeledit_project be_version="5.5.1" version="1.3">
  <preset_collections />
  <framework>i18next</framework>
  <filename>project.babel</filename>
  <source_root_dir />
  <folder_node>
    <name />
    <children>
      <package_node>
        <name>main</name>
        <children />
      </package_node>
    </children>
  </folder_node>
  <embedded_source_texts>false</embedded_source_texts>
  <isTemplateProject>false</isTemplateProject>
  <languages>
    <language>
      <code>de-DE</code>
    </language>
    <language>
      <code>en-US</code>
    </language>
  </languages>
  <translation_packages>
    <translation_package>
      <name>main</name>
      <translation_urls>
        <translation_url>
          <path>en-US.json</path>
          <language>en-US</language>
        </translation_url>
        <translation_url>
          <path>de-DE.json</path>
          <language>de-DE</language>
        </translation_url>
      </translation_urls>
    </translation_package>
  </translation_packages>
  <editor_configuration>
    <save_empty_translations>true</save_empty_translations>
    <translation_order>alphabetically</translation_order>
    <copy_templates>
      <copy_template>'%1'</copy_template>
      <copy_template />
      <copy_template />
    </copy_templates>
    <custom_languages />
    <id_extractor_ignores />
    <machine_translation_formality>default</machine_translation_formality>
    <machine_translation_context />
  </editor_configuration>
  <primary_language>en-US</primary_language>
  <configuration>
    <indent>tab</indent>
    <format>namespaced-json</format>
    <support_arrays>true</support_arrays>
  </configuration>
</babeledit_project>