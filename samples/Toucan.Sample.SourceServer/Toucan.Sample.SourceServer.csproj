<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The reference server for the Toucan source protocol (docs/source-protocol.md). In memory, one demo project, no real
    authentication beyond a bearer token. It exists so the built-in toucan.sources.rest adapter and the conformance suite
    have something real to talk to, and as a starting point for a team's own string service. Not for production use.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Toucan.Sample.SourceServer</RootNamespace>
    <!-- A sample, not a shipped assembly: the strict analyzer profile of the product code does not apply. -->
    <AnalysisMode>Default</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
