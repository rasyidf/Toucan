{
  "name": "Toucan",
  "short_name": "Toucan",
  "description": "Open-source desktop translation editor for app localization files.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F6F7F9",
  "theme_color": "#171B22",
  "icons": [
    { "src": "assets/favicon.ico", "type": "image/x-icon", "sizes": "16x16 32x32" },
    { "src": "assets/icons/icon-192.png", "type": "image/png", "sizes": "192x192" },
    { "src": "assets/icons/icon-512.png", "type": "image/png", "sizes": "512x512" },
    { "src": "assets/icons/icon-192-maskable.png", "type": "image/png", "sizes": "192x192", "purpose": "maskable" },
    { "src": "assets/icons/icon-512-maskable.png", "type": "image/png", "sizes": "512x512", "purpose": "maskable" }
  ]
}
