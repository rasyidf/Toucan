<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The contract between Toucan and plugin assemblies. Keep this small and stable: every public type here is a
    compatibility promise (see PluginApi.Current). It must not reference Toucan.Core or any UI framework.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Toucan.Core</RootNamespace>
    <AssemblyName>Toucan.Plugins.Abstractions</AssemblyName>

    <!-- NuGet package for plugin authors. The version tracks the plugin API (PluginApi.Current), not the app. -->
    <IsPackable>true</IsPackable>
    <PackageId>Toucan.Plugins.Abstractions</PackageId>
    <Version>1.1.0</Version>
    <Authors>rasyid.dev</Authors>
    <Description>Contracts for writing Toucan plugins: file formats, translation providers, validation rules and framework profiles.</Description>
    <PackageTags>toucan;i18n;localization;translation;plugin</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/rasyidf/Toucan</RepositoryUrl>
    <PackageProjectUrl>https://toucan.rasyid.dev</PackageProjectUrl>
    <Copyright>Copyright © Rasyidf 2023-2026</Copyright>

    <!-- IntelliSense for plugin authors. Not every public member is documented yet, so missing-comment warnings stay off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

</Project>
