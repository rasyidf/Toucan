<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="rasyid.dev.Toucan"
    Publisher="CN=rasyid.dev"
    Version="0.22.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Toucan</DisplayName>
    <PublisherDisplayName>rasyid.dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A professional translation resource editor for developers and localization teams.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Toucan" Executable="Toucan.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Toucan"
        Description="Translation resource editor"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo"/>
            <uap:ShowOn Tile="wide310x150Logo"/>
            <uap:ShowOn Tile="square310x310Logo"/>
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>

      <Extensions>
        <!-- .tproj file association -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="toucan-project">
            <uap:SupportedFileTypes>
              <uap:FileType>.tproj</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Toucan Translation Project</uap:DisplayName>
            <uap:Logo>Assets\document.png</uap:Logo>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
