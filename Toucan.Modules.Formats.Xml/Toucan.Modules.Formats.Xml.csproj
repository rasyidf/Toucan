<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built-in module: the Xml family of file formats. References Common and Abstractions only, never Toucan.Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Toucan.Core.Services</RootNamespace>
    <AssemblyName>Toucan.Modules.Formats.Xml</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toucan.Core.Common\Toucan.Core.Common.csproj" />
    <ProjectReference Include="..\Toucan.Plugins.Abstractions\Toucan.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Toucan.Core.Tests" />
  </ItemGroup>

</Project>
