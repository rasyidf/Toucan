<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Toucan.Plugins.Testing\Toucan.Plugins.Testing.csproj" />
    <ProjectReference Include="..\..\samples\Toucan.Sample.Connector\Toucan.Sample.Connector.csproj" />
    <ProjectReference Include="..\..\samples\Toucan.Sample.SourceServer\Toucan.Sample.SourceServer.csproj" />
    <ProjectReference Include="..\..\Toucan.Modules.Sources\Toucan.Modules.Sources.csproj" />
    <!-- Built so the CLI tests can run it as a process; nothing in it is referenced. -->
    <ProjectReference Include="..\..\Toucan.CLI\Toucan.CLI.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
